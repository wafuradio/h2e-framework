                    // Mute/unmute
                    const currentVolume = slider.value;
                    if (currentVolume > 0) {
                        slider.dataset.previousVolume = currentVolume;
                        slider.value = 0;
                        if (currentNarration) currentNarration.volume = 0;
                        if (currentAmbience) currentAmbience.volume = 0;
                        icon.textContent = "🔇";
                    } else {
                        const previousVolume =
                            slider.dataset.previousVolume || 80;
                        slider.value = previousVolume;
                        const volume = previousVolume / 100;
                        if (currentNarration)
                            currentNarration.volume = volume * 0.8;
                        if (currentAmbience)
                            currentAmbience.volume = volume * 0.3;
                        icon.textContent = "🔊";
                    }
                }
            };

            /**
             * Hides volume slider after mouse leaves
             */
            function hideVolumeSlider() {
                const slider = document.getElementById("audio-volume-slider");
                const wrapper = document.getElementById(
                    "volume-control-wrapper",
                );

                volumeHideTimeout = setTimeout(() => {
                    slider.style.display = "none";
                    volumeSliderVisible = false;
                    wrapper.removeEventListener("mouseleave", hideVolumeSlider);
                }, 500);
            }

            // Keep slider visible while hovering
            document.addEventListener("DOMContentLoaded", () => {
                const wrapper = document.getElementById(
                    "volume-control-wrapper",
                );
                if (wrapper) {
                    wrapper.addEventListener("mouseenter", () => {
                        if (volumeHideTimeout) {
                            clearTimeout(volumeHideTimeout);
                            volumeHideTimeout = null;
                        }
                    });
                }
            });



            // =================================================================
            // PROGRESS TRACKING SYSTEM
            // Tracks which chaplets user has started/completed
            // =================================================================
            
            /**
             * Updates all progress indicators on page load
             */
            function updateProgressIndicators() {
                const chaplets = ['prologue', 'chaplet1', 'chaplet2'];
                
                chaplets.forEach(id => {
                    const statusEl = document.getElementById(`status-${id}`);
                    const titleEl = document.querySelector(`[data-chaplet="${id}"] .story-title`);
                    
                    if (!statusEl || !titleEl) return;
                    
                    if (localStorage.getItem(`h2e_${id}_completed`)) {
                        // Completed
                        statusEl.textContent = '✓';
                        statusEl.className = 'story-status completed';
                        titleEl.classList.add('completed');
                        titleEl.classList.remove('in-progress', 'available');
                    } else if (localStorage.getItem(`h2e_${id}_started`)) {
                        // In Progress
                        statusEl.textContent = '▶';
                        statusEl.className = 'story-status in-progress';
                        titleEl.classList.add('in-progress');
                        titleEl.classList.remove('completed', 'available');
                    } else {
                        // Not Started
                        statusEl.textContent = '●';
                        statusEl.className = 'story-status not-started';
                        titleEl.classList.remove('completed', 'in-progress');
                    }
                });
            }
            
            /**
             * Marks a chaplet as started (when user opens it)
             */
            function markAsStarted(chapletId) {
                // Only mark as started if not already completed
                if (!localStorage.getItem(`h2e_${chapletId}_completed`)) {
                    localStorage.setItem(`h2e_${chapletId}_started`, 'true');
                    updateProgressIndicators();
                }
            }
            
            /**
             * Marks a chaplet as finished (user clicks button or reaches end)
             */
            window.markAsFinished = function(chapletId) {
                localStorage.setItem(`h2e_${chapletId}_completed`, 'true');
                localStorage.removeItem(`h2e_${chapletId}_started`); // Remove "in progress"
                updateProgressIndicators();
                
                // Show confirmation
                alert('✓ Chaplet marked as completed!');
            };
            
            /**
             * Resets all progress (hidden terminal command)
             */
            window.resetProgress = function() {
                const chaplets = ['prologue', 'chaplet1', 'chaplet2', 'chaplet3', 'chaplet4', 'chaplet5'];
                chaplets.forEach(id => {
                    localStorage.removeItem(`h2e_${id}_started`);
                    localStorage.removeItem(`h2e_${id}_completed`);
                });
                updateProgressIndicators();
                console.log('Progress reset');
            };
            
            // Update progress indicators when page loads
            updateProgressIndicators();

            // =================================================================
            // UNIFIED READER MODE
            // One reader for Prologue + Chaplets.
            // Audio lives at the top of the reader (Atlantic-style).
            // No separate audio modal. No separate audio buttons.
            // =================================================================

            // ==========================================================
            // Reader audio state (single audio instance for the reader)
            // ==========================================================
            let currentReaderAudio = null;
            let readerProgressInterval = null;
            let currentReaderContentId = null; // prologue | chaplet1 | chaplet2

            /**
             * Formats seconds into M:SS
             */
            function formatTime(seconds) {
                if (!Number.isFinite(seconds) || seconds < 0) return "0:00";
                const m = Math.floor(seconds / 60);
                const s = Math.floor(seconds % 60);
                return `${m}:${s.toString().padStart(2, "0")}`;
            }

            /**
             * Stops and resets the unified reader audio.
             * Called when closing the modal or when switching chapters.
             */
            function stopReaderAudio() {
                if (readerProgressInterval) {
                    clearInterval(readerProgressInterval);
                    readerProgressInterval = null;
                }

                if (currentReaderAudio) {
                    try {
                        currentReaderAudio.pause();
                        currentReaderAudio.currentTime = 0;
                    } catch (e) {
                        // Ignore audio cleanup errors.
                    }
                    currentReaderAudio = null;
                }

                currentReaderContentId = null;
            }

            /**
             * Sets audio volume based on the main page volume slider.
             * This keeps the "feel" consistent even though narration is separate
             * from the ambient sound toggle.
             */
            function getReaderVolume() {
                const slider = document.getElementById("volume-slider");
                const pct = slider ? Number(slider.value || 75) : 75;
                const v = Math.max(0, Math.min(1, pct / 100));
                return v;
            }

            /**
             * Records audio progress separately from reading progress.
             * Keys:
             *  - h2e_<id>_audio_started
             *  - h2e_<id>_audio_completed
             */
            function markAudioStarted(contentId) {
                const key = `h2e_${contentId}_audio_started`;
                if (!localStorage.getItem(key)) localStorage.setItem(key, "true");
            }

            function markAudioCompleted(contentId) {
                localStorage.setItem(`h2e_${contentId}_audio_completed`, "true");
            }

            /**
             * Initializes progress bar seeking for the unified player.
             */
            function wireReaderSeekBar() {
                const progressEl = document.getElementById("reader-progress");
                if (!progressEl) return;

                progressEl.addEventListener("click", (e) => {
                    if (!currentReaderAudio || !currentReaderAudio.duration) return;

                    const rect = progressEl.getBoundingClientRect();
                    const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
                    currentReaderAudio.currentTime = currentReaderAudio.duration * pct;

                    const fill = document.getElementById("reader-progress-fill");
                    if (fill) fill.style.width = `${pct * 100}%`;
                });
            }

            /**
             * Starts the UI update loop (progress + time display).
             */
            function startReaderProgressLoop() {
                if (readerProgressInterval) clearInterval(readerProgressInterval);

                readerProgressInterval = setInterval(() => {
                    if (!currentReaderAudio || !currentReaderAudio.duration) return;

                    const fill = document.getElementById("reader-progress-fill");
                    const timeEl = document.getElementById("reader-time");

                    const pct = (currentReaderAudio.currentTime / currentReaderAudio.duration) * 100;
                    if (fill) fill.style.width = `${pct}%`;

                    if (timeEl) {
                        timeEl.textContent = `${formatTime(currentReaderAudio.currentTime)} / ${formatTime(currentReaderAudio.duration)}`;
                    }
                }, 100);
            }

            /**
             * Toggles playback for the unified reader audio.
             * This is called by the play button inside the reader.
             */
            window.toggleReaderAudio = function (audioFile, contentId) {
                const btn = document.getElementById("reader-audio-btn");

                // First click: create the audio instance.
                if (!currentReaderAudio) {
                    currentReaderAudio = new Audio(audioFile);
                    currentReaderAudio.volume = getReaderVolume();
                    currentReaderContentId = contentId;

                    markAudioStarted(contentId);

                    // When audio ends, mark completed and flip UI state.
                    currentReaderAudio.addEventListener("ended", () => {
                        if (btn) btn.textContent = "↻";
                        markAudioCompleted(contentId);
                        if (readerProgressInterval) clearInterval(readerProgressInterval);
                    });

                    // Play immediately.
                    currentReaderAudio.play();
                    if (btn) btn.textContent = "⏸";

                    wireReaderSeekBar();
                    startReaderProgressLoop();
                    return;
                }

                // If user switched content without closing the modal, reset and start new.
                if (currentReaderContentId !== contentId) {
                    stopReaderAudio();
                    return window.toggleReaderAudio(audioFile, contentId);
                }

                // Toggle pause/resume.
                if (currentReaderAudio.paused) {
                    currentReaderAudio.volume = getReaderVolume();
                    currentReaderAudio.play();
                    if (btn) btn.textContent = "⏸";
                    startReaderProgressLoop();
                } else {
                    currentReaderAudio.pause();
                    if (btn) btn.textContent = "▶";
                }
            };

            /**
             * Unified reader launcher.
             * contentId supported now: prologue | chaplet1 | chaplet2
             */
            window.showUnifiedReader = function (contentId) {
                // Stop any existing reader audio before swapping content.
                stopReaderAudio();

                // ==========================================================
                // Content routing
                // ==========================================================
                let title = "";
                let filename = "";
                let bodyHTML = "";
                let audioFile = "";
                let hasAudio = false;

                // NOTE:
                // We keep chaplet styling consistent across Prologue + Chaplets.
                // That means:
                // - No green "box" wrapper around the text.
                // - White serif body text (Lora).
                // - The same end-of-chaplet navigation buttons you already liked.

                if (contentId === "prologue") {
                    title = "PROLOGUE: Confessions";
                    filename = "PROLOGUE_CONFESSIONS.txt";
                    audioFile = "/sounds/prologue-narration.mp3";
                    hasAudio = true;

                    // Prologue is stored as plain text. Convert to paragraph blocks.
                    const paragraphs = prologueText.split("\n\n").filter((p) => p.trim());
                    bodyHTML = paragraphs
                        .map((p) => `<p style="margin: 0 0 28px 0;">${p.replace(/\n/g, "<br>")}</p>`)
                        .join("");

                } else if (contentId === "chaplet1") {
                    title = "CHAPLET 1: THE GRIT OF I/O";
                    filename = "CHAPLET_1_The_Grit_of_IO.txt";
                    bodyHTML = chaplet1Content;
                    audioFile = "/sounds/chaplet1-placeholder.mp3";
                    hasAudio = true;

                } else if (contentId === "chaplet2") {
                    title = "CHAPLET 2: AssignareFatum()";
                    filename = "CHAPLET_2_AssignareFatum.txt";
                    // Placeholder. When you add chaplet2Content, swap this one line:
                    // bodyHTML = chaplet2Content;
                    bodyHTML = `
                        <p style="margin: 0 0 28px 0; color: #bbb;">
                            Chaplet 2 content is not loaded yet.
                        </p>
                        <p style="margin: 0 0 28px 0; color: #777; font-family: 'Share Tech Mono', monospace;">
                            STATUS: awaiting text payload
                        </p>
                    `;
                    audioFile = "/sounds/chaplet2-placeholder.mp3";
                    hasAudio = true;

                } else if (contentId === "chaplet3") {
                    title = "CHAPLET 3: The Realm Beyond";
                    filename = "CHAPLET_3_The_Realm_Beyond.txt";
                    bodyHTML = `<p style="margin: 0; color: #777;">Locked.</p>`;
                    hasAudio = false;

                } else if (contentId === "chaplet4") {
                    title = "CHAPLET 4: Presence in the Shadows";
                    filename = "CHAPLET_4_Presence_in_the_Shadows.txt";
                    bodyHTML = `<p style="margin: 0; color: #777;">Locked.</p>`;
                    hasAudio = false;

                } else if (contentId === "chaplet5") {
                    title = "CHAPLET 5: Journey to the Grove";
                    filename = "CHAPLET_5_Journey_to_the_Grove.txt";
                    bodyHTML = `<p style="margin: 0; color: #777;">Locked.</p>`;
                    hasAudio = false;
                }

                // ==========================================================
                // Embedded audio bar (Atlantic-style)
                // ==========================================================
                const audioPlayerHTML = hasAudio
                    ? `
                    <div class="reader-audio-player chaplet-audio-player">
                        <div class="audio-controls-row">
                            <button id="reader-audio-btn"
                                    class="audio-play-btn-inline"
                                    onclick="toggleReaderAudio('${audioFile}', '${contentId}')">▶</button>

                            <div class="audio-progress" id="reader-progress">
                                <div class="audio-progress-fill" id="reader-progress-fill"></div>
                            </div>

                            <div class="audio-time-display" id="reader-time">0:00 / 0:00</div>
                        </div>
                    </div>
                    `
                    : "";

                // ==========================================================
                // Footer navigation (match the old chaplet layout)
                // ==========================================================
                let endLabel = "";
                let nextId = "";
                let nextLabel = "";

                if (contentId === "prologue") {
                    endLabel = "END OF PROLOGUE";
                    nextId = "chaplet1";
                    nextLabel = "CONTINUE TO CHAPLET 1";
                } else if (contentId === "chaplet1") {
                    endLabel = "END OF CHAPLET 1";
                    nextId = "chaplet2";
                    nextLabel = "CONTINUE TO CHAPLET 2";
                } else if (contentId === "chaplet2") {
                    endLabel = "END OF CHAPLET 2";
                    nextId = "chaplet3";
                    nextLabel = "CONTINUE TO CHAPLET 3";
                }

                const footerHTML = endLabel
                    ? `
                        <div class="continue-section" style="margin-top: 60px; padding-top: 40px; border-top: 1px solid #333; text-align: center;">
                            <div class="continue-title" style="color: #00ff41; font-size: 16px; margin-bottom: 10px; font-family: 'Share Tech Mono', monospace;">${endLabel}</div>
                            <div style="margin-bottom: 30px;">
                                <a href="#"
                                   onclick="markAsFinished('${contentId}'); return false;"
                                   style="color: #666; font-size: 12px; text-decoration: none; font-family: 'Share Tech Mono', monospace; transition: color 0.3s;"
                                   onmouseover="this.style.color='#00ff41'"
                                   onmouseout="this.style.color='#666'">Mark as finished</a>
                            </div>

                            <button class="continue-btn" onclick="closeModal()"
                                    style="background: transparent; border: 2px solid #00ff41; color: #00ff41; padding: 15px 40px; font-family: 'Share Tech Mono', monospace; font-size: 16px; cursor: pointer; margin: 0 10px;">
                                ⏸ RETURN TO TERMINAL
                            </button>

                            <button class="continue-btn" onclick="showUnifiedReader('${nextId}')"
                                    style="background: transparent; border: 2px solid #00ff41; color: #00ff41; padding: 15px 40px; font-family: 'Share Tech Mono', monospace; font-size: 16px; cursor: pointer; margin: 0 10px;">
                                ▶ ${nextLabel}
                            </button>
                        </div>
                    `
                    : "";

                // ==========================================================
                // Render
                // ==========================================================
                document.getElementById("modal-body").innerHTML = `
                    <div class="chaplet-reader">
                        <div class="chaplet-header">
                            <div class="chaplet-command">$ cat ${filename}</div>
                            <button class="chaplet-close-btn" onclick="closeModal()">✕ CLOSE</button>
                        </div>

                        ${audioPlayerHTML}

                        <div class="chaplet-content">
                            <div class="chaplet-title">${title}</div>

                            <div class="chaplet-text" style="font-family: 'Lora', serif; font-size: 18px; line-height: 1.8; color: #ddd;">
                                ${bodyHTML}
                            </div>

                            ${footerHTML}
                        </div>
                    </div>
                `;

                document.getElementById("content-modal").classList.add("active");

                // If the audio bar exists, wire up seeking and start time loop once playback starts.
                // The loop only runs while audio is playing.
            };

            /**
             * Backwards compatible wrappers.
             * Existing buttons or older links may still call these.
             */
            window.showReadMode = function () {
                window.showUnifiedReader("prologue");
            };

            window.showChapletReadMode = function (chapletId) {
                window.showUnifiedReader(chapletId);
            };

            // =================================================================
            // MODAL CONTROL
            // Functions for opening/closing modals
            // =================================================================

            // Functions for opening/closing modals
            // =================================================================

            /**
             * Closes the content modal and stops any playing audio
             */
            window.closeModal = function () {
                // Stop unified reader audio first.
                stopReaderAudio();

                // Stop any legacy audio (kept for safety if older code paths still trigger).
                if (currentNarration) {
                    try {
                        currentNarration.pause();
                        currentNarration.currentTime = 0;
                    } catch (e) {}
                }
                if (currentAmbience) {
                    try {
                        currentAmbience.pause();
                        currentAmbience.currentTime = 0;
                    } catch (e) {}
                }
                clearInterval(progressInterval);

                // Hide modal
                document.getElementById("content-modal").classList.remove("active");
            };

            // =================================================================
            // STORY MODE FUNCTIONS (PLACEHOLDER)
            // These will be implemented later
            // =================================================================

            /**
             * Shows system logs modal (not yet implemented)
             */
            window.showSystemLogs = function () {
                alert("System Logs - Coming soon!");
            };

            // =================================================================
            // EXIT SYSTEM CONFIRMATION
            // Handles the exit process with confirmation
            // =================================================================

            /**
             * Shows exit confirmation modal
             */
            window.confirmExit = function () {
                document
                    .getElementById("exit-confirmation")
                    .classList.add("active");
            };

            /**
             * Cancels exit and closes confirmation modal
             */
            window.cancelExit = function () {
                document
                    .getElementById("exit-confirmation")
                    .classList.remove("active");
            };

            /**
             * Actually exits the terminal
             * Shows unload animation and navigates to index
             */
            window.executeExit = function () {
                // Hide confirmation modal
                document
                    .getElementById("exit-confirmation")
                    .classList.remove("active");

                // Show unload screen
                document
                    .getElementById("unload-screen")
                    .classList.add("active");

                // Clear session storage so boot sequence shows on next visit
                sessionStorage.removeItem("h2e_terminal_booted");

                // Stop any playing audio
                if (currentNarration) {
                    currentNarration.pause();
                    currentNarration.currentTime = 0;
                }
                if (currentAmbience) {
                    currentAmbience.pause();
                    currentAmbience.currentTime = 0;
                }
                if (ambientSound) {
                    ambientSound.pause();
                    ambientSound.currentTime = 0;
                }

                // Navigate to index after unload animation (2 seconds)
                setTimeout(() => {
                    window.location.href = "/";
                }, 2000);
            };
        </script>

        <!-- =================================================================
         EXIT CONFIRMATION MODAL
         ================================================================= -->
        <div id="exit-confirmation" class="exit-confirmation">
            <div class="exit-modal-content">
                <div class="exit-modal-title">⚠️ CONFIRM SYSTEM EXIT</div>
                <div class="exit-modal-message">
                    Exiting Terminal 13.7 will unload all active processes.
                    Audio feeds will be terminated.<br /> Progress will not be saved.<br
                    /><br />
                    Really exit?
                </div>
                <div class="exit-modal-buttons">
                    <button class="exit-modal-btn" onclick="cancelExit()"
                        >CANCEL</button
                    >
                    <button
                        class="exit-modal-btn danger"
                        onclick="executeExit()">EXIT</button
                    >
                </div>
            </div>
        </div>

        <!-- =================================================================
         UNLOAD SCREEN
         Shows when exiting terminal
         ================================================================= -->
        <div id="unload-screen" class="unload-screen">
            <div class="unload-text">UNLOADING TERMINAL 13.7...</div>
            <div class="unload-bar">
                <div class="unload-fill"></div>
            </div>
        </div>
    </body>
</html>
