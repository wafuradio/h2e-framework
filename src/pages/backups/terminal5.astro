            }

            .reader-close-btn {
                background: transparent;
                border: 2px solid #00ff41;
                color: #00ff41;
                padding: 8px 20px;
                font-family: "Share Tech Mono", monospace;
                font-size: 14px;
                cursor: pointer;
                letter-spacing: 1px;
                transition: all 0.3s;
            }

            .reader-close-btn:hover {
                background: rgba(0, 255, 65, 0.1);
                box-shadow: 0 0 15px rgba(0, 255, 65, 0.3);
            }

            .reader-content {
                max-width: 800px;
                margin: 0 auto;
                padding: 60px 40px 80px;
            }

            .reader-title {
                color: #00ff41;
                font-size: 28px;
                margin-bottom: 40px;
                text-transform: uppercase;
                letter-spacing: 2px;
                font-family: "Share Tech Mono", monospace;
            }

            /* Prologue uses generated paragraph blocks. Chaplets may already contain HTML. */
            .reader-text {
                font-family: "Lora", serif;
                font-size: 18px;
                line-height: 1.8;
                color: #ddd;
            }

            .reader-paragraph {
                margin: 16px 0;
                color: #ddd;
            }

            .reader-quote {
                margin: 22px 0;
                color: #aaa;
                font-style: italic;
                line-height: 1.9;
            }

            .reader-footer {
                margin-top: 60px;
                padding-top: 40px;
                border-top: 1px solid #333;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
                flex-wrap: wrap;
            }

            .reader-mark-finished {
                color: #666;
                font-size: 12px;
                text-decoration: none;
