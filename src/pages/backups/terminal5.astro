                background: rgba(0, 255, 65, 0.05);
            }

            .continue-section {
                margin-top: 60px;
                padding-top: 40px;
                padding-bottom: 80px;
                border-top: 1px solid #333;
                text-align: center;   
            }

            .continue-title {
                color: #00ff41;
                font-size: 16px;
                margin-bottom: 20px;
            }

            .continue-btn {
                background: transparent;
                border: 2px solid #00ff41;
                color: #00ff41;
                padding: 15px 40px;
                font-family: "Share Tech Mono", monospace;
                font-size: 16px;
                cursor: pointer;
                margin: 0 10px;
