                font-size: 11px;
                color: #888;
                margin-bottom: 8px;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            /* Container for 5 signal bars */
            .signal-bars {
                display: flex;
                gap: 4px;
                align-items: flex-end;
                height: 30px;
                margin-bottom: 10px;
            }

            /* Individual signal bar */
            .signal-bar {
                flex: 1;
                background: #222; /* Inactive gray */
                transition: all 0.3s;
            }

            /* Active signal bar (lit up green) */
            .signal-bar.active {
                background: #00ff41;
                box-shadow: 0 0 8px rgba(0, 255, 65, 0.5);
            }

            /* Different heights for each bar */
            .signal-bar:nth-child(1) {
                height: 20%;
            }
            .signal-bar:nth-child(2) {
                height: 40%;
            }
            .signal-bar:nth-child(3) {
                height: 60%;
            }
            .signal-bar:nth-child(4) {
                height: 80%;
            }
            .signal-bar:nth-child(5) {
                height: 100%;
            }

            /* Signal percentage and status text */
            .signal-status {
                font-size: 11px;
                color: #888;
            }

            .signal-status strong {
                color: #00ff41; /* Default green */
            }

            /* Orange text for degraded signal */
            .signal-status.degraded strong {
                color: #ffaa00;
            }

            /* Red text for critical signal */
            .signal-status.critical strong {
                color: #ff4444;
            }

            /* =================================================================
           AUDIO PLAYER (for prologue narration)
           ================================================================= */

            /* Large circular play button */
            .play-button {
                width: 120px;
                height: 120px;
                border: 3px solid #00ff41;
                border-radius: 50%;
                background: transparent;
                color: #00ff41;
                font-size: 48px;
                cursor: pointer;
                transition: all 0.3s;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-family: monospace;
            }

            .play-button:hover {
                background: rgba(0, 255, 65, 0.2);
                box-shadow: 0 0 30px rgba(0, 255, 65, 0.5);
            }

            /* =================================================================
           VOLUME SLIDER (used in multiple places)
           ================================================================= */
            .volume-slider {
                -webkit-appearance: none;
                appearance: none;
                height: 4px;
                background: #333;
                outline: none;
                border-radius: 2px;
                transition: opacity 0.2s;
            }

            /* Slider thumb - Chrome/Safari */
            .volume-slider::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 12px;
                height: 12px;
                background: #888;
                cursor: pointer;
                border-radius: 50%;
            }

            /* Slider thumb - Firefox */
            .volume-slider::-moz-range-thumb {
                width: 12px;
                height: 12px;
                background: #888;
                cursor: pointer;
                border-radius: 50%;
                border: none;
            }

            /* Slider track - Chrome/Safari */
            .volume-slider::-webkit-slider-runnable-track {
                width: 100%;
                height: 4px;
                background: #333;
                border-radius: 2px;
            }

            /* Slider track - Firefox */
            .volume-slider::-moz-range-track {
                width: 100%;
                height: 4px;
                background: #333;
                border-radius: 2px;
            }

            /* Progress indicator - Firefox only */
            .volume-slider::-moz-range-progress {
                background: #555;
                height: 4px;
                border-radius: 2px;
            }

            /* ===================================
           CHAPLET READER - FULL PAGE
           =================================== */
            .chaplet-reader {
                min-height: 100svh;
                background: #000;
                padding-bottom: env(safe-area-inset-bottom);
            }

            .chaplet-header {
                background: rgba(10, 10, 10, 0.98);
