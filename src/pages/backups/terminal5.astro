            }

            .continue-btn:hover {
                background: rgba(0, 255, 65, 0.1);
                box-shadow: 0 0 15px rgba(0, 255, 65, 0.3);
            }

 

            /* =================================================================
           EMAIL CAPTURE SECTION
           ================================================================= */
            .email-capture-section {
                border-top: 1px solid #333;
                padding: 40px 0;
                margin-top: 40px;
            }

            .email-capture-inner {
                max-width: 600px;
                margin: 0 auto;
                text-align: center;
            }

            .email-capture-title {
                font-size: 14px;
                color: #00ff41;
                margin-bottom: 10px;
                letter-spacing: 2px;
