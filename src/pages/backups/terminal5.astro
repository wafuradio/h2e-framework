            }

            .audio-progress-fill {
                height: 100%;
                background: #00ff41;
                width: 0%;
            }

            .audio-time-display {
                font-size: 11px;
                color: #888;
                font-family: "Share Tech Mono", monospace;
                min-width: 90px;
                text-align: right;
            }

            /* Reader header sits under the audio bar */
            .reader-header {
                background: rgba(10, 10, 10, 0.98);
                backdrop-filter: blur(10px);
                border-bottom: 1px solid #00ff41;
                padding: 22px 40px;
