            .email-input:focus {
                border-color: #00ff41;
                box-shadow: 0 0 10px rgba(0, 255, 65, 0.2);
            }

            .email-input::placeholder {
                color: #555;
            }

            .email-submit-btn {
                background: transparent;
                border: 1px solid #00ff41;
                color: #00ff41;
                padding: 12px 30px;
                font-family: 'Share Tech Mono', monospace;
                font-size: 14px;
                cursor: pointer;
                letter-spacing: 2px;
                transition: all 0.3s;
                text-transform: uppercase;
            }

            .email-submit-btn:hover {
                background: rgba(0, 255, 65, 0.1);
                box-shadow: 0 0 15px rgba(0, 255, 65, 0.3);
            }

            .email-privacy-note {
                font-size: 11px;
                color: #666;
                margin-top: 15px;
            }
        
            /* =================================================================
           UNIFIED READER + EMBEDDED AUDIO (ATLANTIC-STYLE)
           This replaces the old modal-based audio UI.
           ================================================================= */

            .unified-reader {
                min-height: 100vh;
                background: #000;
            }

            /* Sticky audio bar at the very top of the reader */
            .reader-audio-player {
                position: sticky;
                top: 0;
                z-index: 150;
                background: rgba(10, 10, 10, 0.98);
                backdrop-filter: blur(10px);
                border-bottom: 1px solid #00ff41;
                padding: 15px 40px;
            }

            
            /* When the reader uses the chaplet header, the audio bar must sit UNDER it.
               This prevents overlap and keeps the command line visible. */
            .chaplet-audio-player {
                top: 72px; /* approx height of .chaplet-header */
                z-index: 140;
            }

            @media (max-width: 768px) {
                .chaplet-audio-player {
                    top: 62px;
                }
            }
.audio-controls-row {
                display: flex;
                align-items: center;
                gap: 15px;
                max-width: 800px;
                margin: 0 auto;
            }

            .audio-play-btn-inline {
