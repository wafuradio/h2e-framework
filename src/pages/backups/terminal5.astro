                text-transform: uppercase;
                letter-spacing: 2px;
                font-family: "Share Tech Mono", monospace;
            }

            .chaplet-text {
                font-family: "Lora", serif !important;
                font-size: 18px !important;
                line-height: 1.8 !important;
                color: #ddd !important;
            }

            .chaplet-text p {
                margin-bottom: 20px;
            }

            .chaplet-text span.fn {
                color: #00ff41 !important;
                font-family:
                    "Share Tech Mono", "Courier New", monospace !important;
            }

            .chaplet-text span.obj {
                color: #ffaa00 !important;
                font-family:
                    "Share Tech Mono", "Courier New", monospace !important;
            }

            .chaplet-text span.sys {
                color: #00d4ff !important;
                font-family:
                    "Share Tech Mono", "Courier New", monospace !important;
            }

            .chaplet-text .dialogue {
                margin-left: 20px;
                color: #fff !important;
                font-style: normal !important;
            }

            .chaplet-text .system-note {
                font-family: "Share Tech Mono", monospace !important;
