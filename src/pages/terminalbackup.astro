            const items = document.querySelectorAll('.dropdown-item');
            const maxIndex = items.length - 1;
            
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                highlightedRealmIndex = Math.min(highlightedRealmIndex + 1, maxIndex);
                updateHighlight();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                highlightedRealmIndex = Math.max(highlightedRealmIndex - 1, 0);
                updateHighlight();
            } else if (e.key === 'Enter') {
                e.preventDefault();
                const realmNumber = highlightedRealmIndex + 1; // Convert back to 1-indexed
                selectRealm(realmNumber);
