            if (savedVolume !== null) {
                volumeLevel = parseInt(savedVolume);
            }
            
            updateSoundUI();
        }

        function saveSoundPreferences() {
            localStorage.setItem('h2e_sound_enabled', soundEnabled.toString());
            localStorage.setItem('h2e_volume_level', volumeLevel.toString());
