---
// Terminal 13.7 - Main Story Interface
// Phase 2A Implementation: Ghost Feed Modal System
// Last Updated: January 6, 2026 - Phase 2A Build
const siteTitle = "H2E Framework - Terminal 13.7";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>{siteTitle}</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Courier+Prime:wght@400;700&display=swap');
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Share Tech Mono', 'Courier New', monospace;
            background: #0a0a0a;
            color: #00ff41;
            overflow-x: hidden;
            line-height: 1.6;
        }
        
        /* ===================================
           BOOT SEQUENCE
           =================================== */
        #boot-sequence {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background: #000;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }
        
        #boot-sequence.hidden {
            display: none;
        }
        
        .boot-text {
            font-size: 14px;
            margin: 5px 0;
            opacity: 0;
            animation: fadeIn 0.5s forwards;
        }
        
        .boot-text:nth-child(1) { animation-delay: 0.5s; }
        .boot-text:nth-child(2) { animation-delay: 1s; }
        .boot-text:nth-child(3) { animation-delay: 1.5s; }
        .boot-text:nth-child(4) { animation-delay: 2s; }
        .boot-text:nth-child(5) { animation-delay: 2.5s; }
        .boot-text:nth-child(6) { animation-delay: 3s; }
        .boot-text:nth-child(7) { animation-delay: 3.5s; }
        
        .progress-bar {
            width: 300px;
            height: 20px;
            border: 1px solid #00ff41;
            margin: 20px 0;
            opacity: 0;
            animation: fadeIn 0.5s forwards 4s;
        }
        
        .progress-fill {
            height: 100%;
            background: #00ff41;
            width: 0%;
            animation: fillProgress 2s forwards 4s;
        }
        
        @keyframes fadeIn {
            to { opacity: 1; }
        }
        
        @keyframes fillProgress {
            to { width: 100%; }
        }
        
        /* Subtle scanline effect for ghost feed */
        @keyframes scanline {
            0% { transform: translateY(-100%); }
            100% { transform: translateY(100%); }
        }
        
        /* ===================================
           ENTER TERMINAL SCREEN
           =================================== */
        #enter-terminal-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background: #000;
            z-index: 9998;
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            transition: opacity 0.5s;
        }
        
        #enter-terminal-screen.active {
            display: flex;
        }
        
        #enter-terminal-screen.hidden {
            opacity: 0;
            pointer-events: none;
        }
        
        .enter-terminal-title {
            font-size: 32px;
            margin-bottom: 40px;
            letter-spacing: 4px;
        }
        
        #enter-terminal-btn {
            background: transparent;
            border: 2px solid #00ff41;
            color: #00ff41;
            padding: 20px 60px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 18px;
            cursor: pointer;
            letter-spacing: 2px;
            transition: all 0.3s;
            margin-bottom: 30px;
        }
        
        #enter-terminal-btn:hover {
            background: rgba(0, 255, 65, 0.1);
            box-shadow: 0 0 20px rgba(0, 255, 65, 0.5);
        }
        
        .escape-link {
            font-size: 12px;
            color: #666;
            text-decoration: none;
            transition: color 0.3s;
        }
        
        .escape-link:hover {
            color: #888;
        }

        /* ===================================
           MAIN TERMINAL
           =================================== */
        #main-terminal {
            display: none;
            min-height: 100vh;
            padding: 20px;
            max-width: 1400px;
            margin: 0 auto;
        }
        
        #main-terminal.active {
            display: block;
        }
        
        /* Header */
        .terminal-header {
            border: 1px solid #00ff41;
            padding: 15px 20px;
            margin-bottom: 30px;
            background: rgba(0, 255, 65, 0.05);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }
        
        .header-left {
            flex: 1;
        }
        
        .terminal-title {
            font-size: 18px;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        
        .terminal-status {
            font-size: 11px;
            color: #ff4444;
        }
        
        .header-right {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
        }
        
        .sound-control {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .sound-toggle {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            padding: 8px 12px;
            border: 1px solid #00ff41;
            background: rgba(0, 255, 65, 0.1);
            transition: all 0.3s;
            font-size: 12px;
        }
        
        .sound-toggle:hover {
            background: rgba(0, 255, 65, 0.2);
            box-shadow: 0 0 10px rgba(0, 255, 65, 0.3);
        }
        
        .volume-control {
            display: none;
            align-items: center;
            gap: 8px;
        }
        
        .volume-control.visible {
            display: flex;
        }
        
        .volume-slider {
            width: 100px;
            height: 4px;
            -webkit-appearance: none;
            appearance: none;
            background: #333;
            outline: none;
            border-radius: 2px;
        }
        
        .volume-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 12px;
            height: 12px;
            background: #00ff41;
            cursor: pointer;
            border-radius: 50%;
        }
        
        .volume-slider::-moz-range-thumb {
            width: 12px;
            height: 12px;
            background: #00ff41;
            cursor: pointer;
            border-radius: 50%;
            border: none;
        }
        
        .volume-label {
            font-size: 11px;
            color: #888;
            min-width: 35px;
        }
        
        .escape-link-header {
            font-size: 11px;
            color: #666;
            text-decoration: none;
            transition: color 0.3s;
        }
        
        .escape-link-header:hover {
            color: #888;
        }
        
        /* Priority Alert */
        .priority-alert {
            margin-bottom: 40px;
            padding: 20px;
            border-left: 3px solid #ff4444;
            background: rgba(255, 68, 68, 0.05);
        }
        
        .alert-title {
            font-size: 14px;
            color: #ff4444;
            margin-bottom: 15px;
            letter-spacing: 1px;
        }
        
        .alert-text {
            font-size: 16px;
            color: #ddd;
            line-height: 1.8;
        }
        
        .thread-names {
            color: #00ff41;
        }
        
        /* Section Divider */
        .section-divider {
            height: 1px;
            background: #333;
            margin: 40px 0;
        }
        
        /* Section Headers */
        .section-header {
            font-size: 14px;
            color: #00ff41;
            margin-bottom: 20px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        
        /* Story List */
        .story-list {
            list-style: none;
            margin-bottom: 40px;
        }
        
        .story-item {
            padding: 12px 0;
            border-bottom: 1px solid #222;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s;
        }
        
        .story-item:hover {
            padding-left: 10px;
            border-left: 2px solid #00ff41;
        }
        
        .story-title {
            color: #ddd;
            font-size: 14px;
        }
        
        .story-title.available {
            color: #00ff41;
        }
        
        .story-title.corrupted {
            color: #ff4444;
            text-decoration: line-through;
        }
        
        .story-actions {
            display: flex;
            gap: 15px;
        }
        
        .story-btn {
            background: transparent;
            border: 1px solid #00ff41;
            color: #00ff41;
            padding: 5px 12px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 11px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .story-btn:hover {
            background: rgba(0, 255, 65, 0.1);
            box-shadow: 0 0 8px rgba(0, 255, 65, 0.3);
        }
        
        .story-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }
        
        /* Reference Links */
        .reference-links {
            display: flex;
            gap: 20px;
            margin-bottom: 40px;
        }
        
        .reference-link {
            color: #00ff41;
            text-decoration: none;
            font-size: 13px;
            padding: 8px 15px;
            border: 1px solid #00ff41;
            transition: all 0.3s;
        }
        
        .reference-link:hover {
            background: rgba(0, 255, 65, 0.1);
            box-shadow: 0 0 10px rgba(0, 255, 65, 0.3);
        }
        
        /* Terminal Hint */
        .terminal-hint {
            text-align: center;
            padding: 30px;
            color: #666;
            font-size: 12px;
            border-top: 1px solid #222;
        }
        
        /* Hidden Terminal */
        #hidden-terminal {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.95);
            border-top: 2px solid #00ff41;
            padding: 20px;
            display: none;
            z-index: 10000;
        }
        
        #hidden-terminal.active {
            display: block;
        }
        
        .terminal-output {
            max-height: 200px;
            overflow-y: auto;
            margin-bottom: 10px;
            font-size: 12px;
            color: #ddd;
        }
        
        .terminal-input-line {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        
        .terminal-prompt {
            color: #00ff41;
        }
        
        #terminal-input {
            flex: 1;
            background: transparent;
            border: none;
            color: #00ff41;
            font-family: 'Share Tech Mono', monospace;
            font-size: 12px;
            outline: none;
        }
        
        /* Modal System */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 10001;
            overflow-y: auto;
            padding: 40px 20px;
        }
        
        .modal.active {
            display: block;
        }
        
        .modal-content {
            max-width: 900px;
            margin: 0 auto;
            border: 1px solid #00ff41;
            padding: 30px;
            background: #0a0a0a;
            position: relative;
        }
        
        .modal-content:has(.terminal-reader-wrapper) {
            border: none;
            padding: 0;
            background: transparent;
        }
        
        .modal-close {
            position: absolute;
            top: 10px;
            right: 10px;
            background: none;
            border: 1px solid #00ff41;
            color: #00ff41;
            padding: 5px 15px;
            cursor: pointer;
            font-family: inherit;
            font-size: 12px;
            transition: all 0.3s;
        }
        
        .modal-close:hover {
            background: rgba(0, 255, 65, 0.2);
        }
        
        .modal-content:has(.terminal-reader-wrapper) .modal-close {
            display: none;
        }
        
        /* ===================================
           GHOST FEED MODAL
           =================================== */
        .ghost-feed-container {
            padding: 20px;
        }
        
        .ghost-feed-header {
            border-left: 3px solid #ffaa00;
            padding-left: 15px;
            margin-bottom: 30px;
        }
        
        .ghost-feed-title {
            font-size: 18px;
            color: #ffaa00;
            margin-bottom: 8px;
            letter-spacing: 1px;
        }
        
        .ghost-feed-subtitle {
            font-size: 12px;
            color: #888;
        }
        
        .ghost-feed-warning {
            background: rgba(255, 170, 0, 0.1);
            border: 1px solid #ffaa00;
            padding: 12px 15px;
            margin-bottom: 30px;
            font-size: 11px;
            color: #ffaa00;
            line-height: 1.6;
        }
        
        .realm-selector {
            margin-bottom: 30px;
        }
        
        .realm-selector-label {
            display: block;
            font-size: 12px;
            color: #888;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        /* Custom Terminal Dropdown */
        .custom-dropdown {
            position: relative;
        }
        
        .dropdown-display {
            width: 100%;
            background: #000;
            border: 1px solid #00ff41;
            color: #00ff41;
            padding: 12px 15px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .dropdown-display:hover {
            background: rgba(0, 255, 65, 0.05);
            box-shadow: 0 0 10px rgba(0, 255, 65, 0.3);
        }
        
        .dropdown-display.active {
            border-bottom: none;
        }
        
        .dropdown-arrow {
            color: #666;
            font-size: 12px;
        }
        
        .dropdown-menu {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: #000;
            border: 1px solid #00ff41;
            border-top: none;
            max-height: 300px;
            overflow-y: auto;
            display: none;
            z-index: 1000;
        }
        
        .dropdown-menu.active {
            display: block;
        }
        
        .dropdown-item {
            padding: 12px 15px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 13px;
            color: #888;
            cursor: pointer;
            transition: all 0.2s;
            border-bottom: 1px solid #111;
        }
        
        .dropdown-item:last-child {
            border-bottom: none;
        }
        
        .dropdown-item:hover {
            background: rgba(0, 255, 65, 0.1);
            color: #00ff41;
            padding-left: 20px;
        }
        
        .dropdown-item.selected {
            color: #00ff41;
        }
        
        .dropdown-item.selected::before {
            content: '> ';
            color: #00ff41;
        }
        
        .dropdown-item.highlighted {
            background: #00ff41;
            color: #000;
        }
        
        .dropdown-item.highlighted::before {
            content: '▶ ';
            color: #000;
        }
        
        .dropdown-item.highlighted:hover {
            padding-left: 15px; /* Override hover padding when highlighted */
        }
        
        .realm-number {
            display: inline-block;
            width: 25px;
            color: #666;
        }
        
        .dropdown-item.highlighted .realm-number {
            color: #000;
        }
        
        .feed-window {
            border: 1px solid #333;
            background: #000;
            min-height: 400px;
            margin-bottom: 20px;
            position: relative;
            overflow: hidden;
        }
        
        .feed-window::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: rgba(0, 255, 65, 0.3);
            animation: scanline 3s linear infinite;
            pointer-events: none;
        }
        
        .feed-content {
            padding: 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 400px;
        }
        
        .feed-placeholder {
            width: 100%;
            max-width: 500px;
            aspect-ratio: 16/9;
            background: rgba(0, 255, 65, 0.05);
            border: 1px dashed #333;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .feed-placeholder-icon {
            font-size: 48px;
            opacity: 0.3;
        }
        
        .feed-placeholder-text {
            font-size: 12px;
            color: #666;
            text-align: center;
        }
        
        .feed-image {
            width: 100%;
            max-width: 500px;
            height: auto;
            display: block;
            border: 1px solid #333;
        }
        
        .realm-description {
            font-size: 13px;
            color: #888;
            line-height: 1.8;
            text-align: center;
            max-width: 500px;
            margin: 0 auto;
        }
        
        .signal-quality {
            border-top: 1px solid #333;
            padding-top: 20px;
            margin-top: 20px;
        }
        
        .signal-quality-label {
            font-size: 11px;
            color: #888;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .signal-bars {
            display: flex;
            gap: 4px;
            align-items: flex-end;
            height: 30px;
            margin-bottom: 10px;
        }
        
        .signal-bar {
            flex: 1;
            background: #222;
            transition: all 0.3s;
        }
        
        .signal-bar.active {
            background: #00ff41;
            box-shadow: 0 0 8px rgba(0, 255, 65, 0.5);
        }
        
        .signal-bar:nth-child(1) { height: 20%; }
        .signal-bar:nth-child(2) { height: 40%; }
        .signal-bar:nth-child(3) { height: 60%; }
        .signal-bar:nth-child(4) { height: 80%; }
        .signal-bar:nth-child(5) { height: 100%; }
        
        .signal-status {
            font-size: 11px;
            color: #888;
        }
        
        .signal-status strong {
            color: #00ff41;
        }
        
        .signal-status.degraded strong {
            color: #ffaa00;
        }
        
        .signal-status.critical strong {
            color: #ff4444;
        }
        
        /* Audio Player */
        .audio-feed {
            text-align: center;
            padding: 60px 40px;
        }
        
        .audio-title {
            font-size: 20px;
            margin-bottom: 30px;
            color: #00ff41;
        }
        
        .play-button {
            width: 120px;
            height: 120px;
            border: 3px solid #00ff41;
            border-radius: 50%;
            background: transparent;
            color: #00ff41;
            font-size: 48px;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: monospace;
        }
        
        .play-button:hover {
            background: rgba(0, 255, 65, 0.2);
            box-shadow: 0 0 30px rgba(0, 255, 65, 0.5);
        }
        
        /* Volume Slider */
        .volume-slider {
            -webkit-appearance: none;
            appearance: none;
            height: 4px;
            background: #333;
            outline: none;
            border-radius: 2px;
            transition: opacity 0.2s;
        }
        
        .volume-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 12px;
            height: 12px;
            background: #888;
            cursor: pointer;
            border-radius: 50%;
        }
        
        .volume-slider::-moz-range-thumb {
            width: 12px;
            height: 12px;
            background: #888;
            cursor: pointer;
            border-radius: 50%;
            border: none;
        }
        
        .volume-slider::-webkit-slider-runnable-track {
            width: 100%;
            height: 4px;
            background: #333;
            border-radius: 2px;
        }
        
        .volume-slider::-moz-range-track {
            width: 100%;
            height: 4px;
            background: #333;
            border-radius: 2px;
        }
        
        .volume-slider::-moz-range-progress {
            background: #555;
            height: 4px;
            border-radius: 2px;
        }
    </style>
</head>
<body>

    <!-- Boot Sequence -->
    <div id="boot-sequence">
        <div class="boot-text">H2E FRAMEWORK v3.2</div>
        <div class="boot-text">TERMINAL 13.7 // I/O BORDER NODE</div>
        <div class="boot-text">Authenticating...</div>
        <div class="boot-text">Loading system protocols...</div>
        <div class="boot-text">Establishing connection...</div>
        <div class="boot-text">Access granted</div>
        <div class="progress-bar">
            <div class="progress-fill"></div>
        </div>
    </div>

    <!-- Enter Terminal Screen -->
    <div id="enter-terminal-screen">
        <div class="enter-terminal-title">TERMINAL 13.7</div>
        <button id="enter-terminal-btn">▶ ENTER TERMINAL</button>
        <a href="/" class="escape-link">Return to index</a>
    </div>

    <!-- Main Terminal -->
    <div id="main-terminal">
        <!-- Header -->
        <div class="terminal-header">
            <div class="header-left">
                <div class="terminal-title">H2E Framework - Terminal 13.7</div>
                <div class="terminal-status">STATUS: COMPROMISED // LB 3.2 DEPLOYED</div>
            </div>
            <div class="header-right">
                <div class="sound-control">
                    <div class="sound-toggle" onclick="toggleSound()">
                        <span id="sound-icon">🔇</span>
                        <span id="sound-label">SOUND: OFF</span>
                    </div>
                    <div class="volume-control" id="volume-control">
                        <input type="range" id="volume-slider" class="volume-slider" min="0" max="100" value="75">
                        <span class="volume-label" id="volume-label">75%</span>
                    </div>
                </div>
                <a href="/" class="escape-link-header">Return to index</a>
            </div>
        </div>

        <!-- Priority Alert -->
        <div class="priority-alert">
            <div class="alert-title">ACTIVE THREAD</div>
            <div class="alert-text">
                <span class="thread-names">desmondJohn | jessMartin | isidoreAbraham</span>
                <br><br>
                Three PreBorn marked for deletion.<br>
                The system has already decided.
            </div>
        </div>

        <div class="section-divider"></div>

        <!-- Story Archives -->
        <div class="section-header">Begin Reading</div>
        <ul class="story-list">
            <li class="story-item">
                <span class="story-title available">Prologue: Confessions</span>
                <div class="story-actions">
                    <button class="story-btn" onclick="showAudioMode('prologue')">🎧 AUDIO</button>
                    <button class="story-btn" onclick="showReadMode('prologue')">📄 READ</button>
                </div>
            </li>
            <li class="story-item">
                <span class="story-title">Chaplet 1: The Grit of I/O</span>
                <div class="story-actions">
                    <button class="story-btn" disabled>🎧 AUDIO</button>
                    <button class="story-btn" disabled>📄 READ</button>
                </div>
            </li>
            <li class="story-item">
                <span class="story-title">Chaplet 2: AssignareFatum()</span>
                <div class="story-actions">
                    <button class="story-btn" disabled>🎧 AUDIO</button>
                    <button class="story-btn" disabled>📄 READ</button>
                </div>
            </li>
