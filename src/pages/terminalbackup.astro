            const initialButton = document.getElementById('initial-play-button');
            if (initialButton) initialButton.style.display = 'none';
            document.getElementById('progress-container').style.display = 'block';
            
            document.getElementById('audio-play-btn').textContent = '⏸';
            document.getElementById('audio-play-btn').onclick = pauseAudio;
            
            setupScrubber();
            
            progressInterval = setInterval(() => {
                if (!isDragging && currentNarration && currentNarration.duration) {
                    const progress = (currentNarration.currentTime / currentNarration.duration) * 100;
                    document.getElementById('progress-fill').style.width = progress + '%';
                    
                    const currentMin = Math.floor(currentNarration.currentTime / 60);
                    const currentSec = Math.floor(currentNarration.currentTime % 60);
                    const totalMin = Math.floor(currentNarration.duration / 60);
                    const totalSec = Math.floor(currentNarration.duration % 60);
                    
                    document.getElementById('time-display').textContent = 
                        `${currentMin}:${currentSec.toString().padStart(2, '0')} / ${totalMin}:${totalSec.toString().padStart(2, '0')}`;
                }
            }, 100);
            
            currentNarration.addEventListener('ended', () => {
                currentAmbience.pause();
                clearInterval(progressInterval);
                document.getElementById('audio-play-btn').textContent = '🔄';
                document.getElementById('audio-play-btn').onclick = () => playAudio();
            });
            
            const volumeSlider = document.getElementById('audio-volume-slider');
            volumeSlider.addEventListener('input', (e) => {
                const volume = e.target.value / 100;
                if (currentNarration) currentNarration.volume = volume * 0.8;
                if (currentAmbience) currentAmbience.volume = volume * 0.3;
            });
        };

        function setupScrubber() {
            const progressBar = document.getElementById('progress-bar');
            const handle = document.getElementById('scrubber-handle');
            const progressFill = document.getElementById('progress-fill');
            
            progressBar.addEventListener('click', (e) => {
                if (e.target === handle) return;
                seekToPosition(e.clientX, progressBar);
            });
            
            handle.addEventListener('mousedown', startDrag);
            
            function startDrag(e) {
                isDragging = true;
                handle.style.cursor = 'grabbing';
                document.addEventListener('mousemove', drag);
                document.addEventListener('mouseup', stopDrag);
                e.preventDefault();
            }
            
            function drag(e) {
                if (!isDragging) return;
                seekToPosition(e.clientX, progressBar);
            }
            
            function stopDrag() {
                isDragging = false;
                handle.style.cursor = 'grab';
                document.removeEventListener('mousemove', drag);
                document.removeEventListener('mouseup', stopDrag);
            }
            
            function seekToPosition(clientX, progressBar) {
                if (!currentNarration || !currentNarration.duration) return;
                
                const rect = progressBar.getBoundingClientRect();
                const clickX = clientX - rect.left;
                const width = rect.width;
                const percentage = Math.max(0, Math.min(1, clickX / width));
                
                currentNarration.currentTime = currentNarration.duration * percentage;
                progressFill.style.width = (percentage * 100) + '%';
                
                const currentMin = Math.floor(currentNarration.currentTime / 60);
                const currentSec = Math.floor(currentNarration.currentTime % 60);
                const totalMin = Math.floor(currentNarration.duration / 60);
                const totalSec = Math.floor(currentNarration.duration % 60);
                
                document.getElementById('time-display').textContent = 
                    `${currentMin}:${currentSec.toString().padStart(2, '0')} / ${totalMin}:${totalSec.toString().padStart(2, '0')}`;
            }
        }

        window.pauseAudio = function() {
            if (currentNarration) currentNarration.pause();
            if (currentAmbience) currentAmbience.pause();
            clearInterval(progressInterval);
            document.getElementById('audio-play-btn').textContent = '▶️';
            document.getElementById('audio-play-btn').onclick = resumeAudio;
        };

        window.resumeAudio = function() {
            if (currentNarration) currentNarration.play();
            if (currentAmbience) currentAmbience.play();
            
            progressInterval = setInterval(() => {
                if (currentNarration && currentNarration.duration) {
                    const progress = (currentNarration.currentTime / currentNarration.duration) * 100;
                    document.getElementById('progress-fill').style.width = progress + '%';
                    
                    const currentMin = Math.floor(currentNarration.currentTime / 60);
                    const currentSec = Math.floor(currentNarration.currentTime % 60);
                    const totalMin = Math.floor(currentNarration.duration / 60);
                    const totalSec = Math.floor(currentNarration.duration % 60);
                    
                    document.getElementById('time-display').textContent = 
                        `${currentMin}:${currentSec.toString().padStart(2, '0')} / ${totalMin}:${totalSec.toString().padStart(2, '0')}`;
                }
            }, 100);
            
            document.getElementById('audio-play-btn').textContent = '⏸';
            document.getElementById('audio-play-btn').onclick = pauseAudio;
        };

        let volumeSliderVisible = false;
        let volumeHideTimeout = null;
        
        window.toggleVolumeSlider = function() {
            const slider = document.getElementById('audio-volume-slider');
            const wrapper = document.getElementById('volume-control-wrapper');
            const icon = document.getElementById('audio-volume-icon');
            
            if (!volumeSliderVisible) {
                slider.style.display = 'block';
                volumeSliderVisible = true;
                wrapper.addEventListener('mouseleave', hideVolumeSlider);
            } else {
                const currentVolume = slider.value;
                if (currentVolume > 0) {
                    slider.dataset.previousVolume = currentVolume;
                    slider.value = 0;
                    if (currentNarration) currentNarration.volume = 0;
                    if (currentAmbience) currentAmbience.volume = 0;
                    icon.textContent = '🔇';
                } else {
                    const previousVolume = slider.dataset.previousVolume || 80;
                    slider.value = previousVolume;
                    const volume = previousVolume / 100;
                    if (currentNarration) currentNarration.volume = volume * 0.8;
                    if (currentAmbience) currentAmbience.volume = volume * 0.3;
                    icon.textContent = '🔊';
                }
            }
        };
        
        function hideVolumeSlider() {
            const slider = document.getElementById('audio-volume-slider');
            const wrapper = document.getElementById('volume-control-wrapper');
            
            volumeHideTimeout = setTimeout(() => {
                slider.style.display = 'none';
                volumeSliderVisible = false;
                wrapper.removeEventListener('mouseleave', hideVolumeSlider);
            }, 500);
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            const wrapper = document.getElementById('volume-control-wrapper');
            if (wrapper) {
                wrapper.addEventListener('mouseenter', () => {
                    if (volumeHideTimeout) {
                        clearTimeout(volumeHideTimeout);
                        volumeHideTimeout = null;
                    }
                });
            }
        });

        // ========================================
        // READ MODE
        // ========================================
        window.showReadMode = function(chapter) {
            const paragraphs = prologueText.split('\n\n').filter(p => p.trim());
            
            let formattedHTML = '';
            paragraphs.forEach(para => {
                const lines = para.split('\n');
                if (lines[0].trim().startsWith('"') && lines[lines.length - 1].trim().endsWith('"')) {
                    formattedHTML += `<div style="color: #aaaaaa; font-style: italic; margin: 25px 0; line-height: 1.9;">${para}</div>`;
                } else {
                    formattedHTML += `<div style="color: #ffffff; margin: 15px 0; line-height: 1.9;">${para.replace(/\n/g, '<br>')}</div>`;
                }
            });
            
            document.getElementById('modal-body').innerHTML = `
                <div class="terminal-reader-wrapper" style="border: 1px solid #3a4a5a; border-radius: 8px; overflow: hidden; background: #000; max-width: 900px; margin: 0 auto;">
                    <div style="background: #000; border-radius: 8px; overflow: hidden; min-height: 600px; max-height: 80vh; display: flex; flex-direction: column;">
                        <div style="background: #3a4a5a; padding: 12px 15px; display: flex; align-items: center;">
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <div onclick="closeModal()" style="width: 12px; height: 12px; border-radius: 50%; background: #ff5f56; cursor: pointer;" title="Close"></div>
                                <div style="width: 12px; height: 12px; border-radius: 50%; background: #ffbd2e;"></div>
                                <div style="width: 12px; height: 12px; border-radius: 50%; background: #27c93f;"></div>
                            </div>
                            <div style="font-size: 13px; color: #999999; margin-left: 10px;">Terminal 13.7</div>
                        </div>
                        
                        <div style="flex: 1; overflow-y: auto; padding: 30px 40px; background: #000;">
                            <div style="color: #00ff41; margin-bottom: 25px; font-size: 14px;">
                                <span style="color: #888;">$</span> cat PROLOGUE_Confessions.txt
                            </div>
                            
                            <div style="font-size: 15px;">
                                ${formattedHTML}
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            document.getElementById('content-modal').classList.add('active');
        };

        // ========================================
        // MODAL CONTROL
        // ========================================
        window.closeModal = function() {
            if (currentNarration) {
                currentNarration.pause();
                currentNarration.currentTime = 0;
            }
            if (currentAmbience) {
                currentAmbience.pause();
                currentAmbience.currentTime = 0;
            }
            clearInterval(progressInterval);
            
            document.getElementById('content-modal').classList.remove('active');
        };

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && document.getElementById('content-modal').classList.contains('active')) {
                closeModal();
            }
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            const dropdown = document.getElementById('dropdown-menu');
            const display = document.getElementById('dropdown-display');
            
            if (dropdown && display && 
                !dropdown.contains(e.target) && 
                !display.contains(e.target) &&
                dropdown.classList.contains('active')) {
                dropdown.classList.remove('active');
                display.classList.remove('active');
                dropdownOpen = false;
            }
        });

        // ========================================
        // STORY MODE FUNCTIONS (PLACEHOLDER)
        // ========================================
        window.showSystemLogs = function() {
            alert('System Logs - Coming soon!');
        };
    </script>

</body>
