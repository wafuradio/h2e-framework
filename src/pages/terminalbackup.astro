        function handleDropdownKeydown(e) {
            // Only handle keys when modal is open and dropdown is active
            if (!document.getElementById('content-modal').classList.contains('active')) {
                return;
            }
            
            // Only handle arrow keys and Enter when dropdown is visible
            if (!dropdownOpen) {
                return;
