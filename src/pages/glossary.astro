---
// Glossary - System Terminology Database
// Entries come from src/data/glossary.ts (built from Lisa's Glossary export in canon/).
// Entries and locked lines unlock as the reader finishes chaplets. TBD content is
// stripped on the server and never reaches the browser.
import { publicGlossary } from "../data/glossary.ts";

const siteTitle = "H2E Framework - Glossary";
const glossary = publicGlossary();
const glossaryJson = JSON.stringify(glossary).replace(/</g, "\\u003c");
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{siteTitle}</title>
    <style is:global>
        @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Courier+Prime:wght@400;700&display=swap');
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Share Tech Mono', 'Courier New', monospace;
            background: #0a0a0a;
            color: #00ff41;
            line-height: 1.6;
            padding: 30px;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
        }
        
        /* Header */
        .glossary-header {
            border: 1px solid #00ff41;
            padding: 20px;
            margin-bottom: 40px;
            background: rgba(0, 255, 65, 0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .glossary-title {
            font-size: 24px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        
        .nav-button {
            display: inline-block;
            padding: 10px 20px;
            border: 1px solid #00ff41;
            background: transparent;
            color: #00ff41;
            font-size: 11px;
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.3s;
            font-family: 'Share Tech Mono', monospace;
        }
        
        .nav-button:hover {
            background: rgba(0, 255, 65, 0.1);
            box-shadow: 0 0 15px rgba(0, 255, 65, 0.3);
        }
        
        /* Search & Filters */
        .controls {
            margin-bottom: 40px;
        }
        
        .search-bar {
            max-width: 500px;
            background: #000;
            border: 1px solid #00ff41;
            color: #00ff41;
            padding: 15px 20px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 14px;
            margin-bottom: 20px;
            outline: none;
        }
        
        .search-bar::placeholder {
            color: #666;
        }
        
        .search-bar:focus {
            box-shadow: 0 0 10px rgba(0, 255, 65, 0.3);
        }
        
        .filter-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        .filter-btn {
            background: transparent;
            border: 1px solid #333;
            color: #888;
            padding: 8px 16px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .filter-btn:hover {
            border-color: #00ff41;
            color: #00ff41;
        }
        
        .filter-btn.active {
            background: rgba(0, 255, 65, 0.1);
            border-color: #00ff41;
            color: #00ff41;
        }
        
        /* Results Info */
        .results-info {
            font-size: 12px;
            color: #666;
            margin-bottom: 20px;
        }
        
        .results-info .count {
            color: #00ff41;
        }
        
        /* Term Grid */
        .term-grid {
            display: grid !important;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)) !important;
            gap: 25px;
            margin-bottom: 40px;
        }
        
        /* Section Headers (like Registry) */
        .section-divider {
            grid-column: 1 / -1;
            margin: 30px 0 20px 0;
            padding-left: 5px;
            border-left: 3px solid #ffaa00;
        }
        
        .section-divider:first-child {
            margin-top: 0;
        }
        
        .section-title {
            font-size: 14px;
            color: #ffaa00;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: bold;
        }
        
        .section-count {
            font-size: 11px;
            color: #666;
            margin-left: 10px;
        }
        
        /* Term Card */
        .term-card {
            border: 1px solid #333;
            background: rgba(0, 255, 65, 0.02);
            padding: 20px;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
            min-height: 120px;
        }
        
        .term-card:hover {
            border-color: #00ff41;
            background: rgba(0, 255, 65, 0.05);
            box-shadow: 0 0 15px rgba(0, 255, 65, 0.2);
        }
        
        
        
        .term-category {
            font-size: 10px;
            color: #ffaa00;
            background: rgba(255, 170, 0, 0.1);
            border: 1px solid rgba(255, 170, 0, 0.3);
            padding: 4px 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
            display: inline-block;
        }
        
        .term-name {
            font-size: 18px;
            color: #00ff41;
            margin-bottom: 12px;
        }
        
        .term-short {
            font-size: 12px;
            color: #888;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        
        .has-code-badge {
            display: inline-block;
            font-size: 9px;
            color: #00d9ff;
            background: rgba(0, 217, 255, 0.1);
            border: 1px solid #00d9ff;
            padding: 2px 6px;
            margin-left: 8px;
            text-transform: uppercase;
        }
        
        /* No Results */
        .no-results {
            text-align: center;
            padding: 60px 20px;
            color: #666;
        }
        
        .no-results-icon {
            font-size: 48px;
            margin-bottom: 20px;
            opacity: 0.3;
        }
        
        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 10001;
            overflow-y: auto;
            padding: 40px 20px;
        }
        
        .modal.active {
            display: block;
        }
        
        .modal-content {
            max-width: 900px;
            margin: 0 auto;
            border: 1px solid #00ff41;
            padding: 40px;
            background: #0a0a0a;
            position: relative;
        }
        
        .modal-close {
            position: absolute;
            top: 15px;
            right: 15px;
            background: none;
            border: 1px solid #00ff41;
            color: #00ff41;
            padding: 5px 15px;
            cursor: pointer;
            font-family: inherit;
            font-size: 12px;
            transition: all 0.3s;
        }
        
        .modal-close:hover {
            background: rgba(0, 255, 65, 0.2);
        }
        
        .modal-term-name {
            font-size: 28px;
            color: #00ff41;
            margin-bottom: 10px;
        }
        
        .modal-term-category {
            font-size: 11px;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 25px;
        }
        
        .modal-term-definition {
            font-size: 14px;
            color: #ddd;
            line-height: 1.8;
            margin-bottom: 30px;
        }
        
        .code-snippet-section {
            margin-top: 30px;
        }
        
        .code-snippet-title {
            font-size: 12px;
            color: #00d9ff;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .code-snippet {
            background: #000;
            border: 1px solid #00d9ff;
            padding: 20px;
            font-family: 'Courier Prime', 'Courier New', monospace;
            font-size: 13px;
            color: #00d9ff;
            line-height: 1.6;
            overflow-x: auto;
            white-space: pre;
        }
        
        .code-comment {
            color: #666;
        }
        
        @media (max-width: 768px) {
            .term-grid {
                grid-template-columns: 1fr;
            }
            
            .filter-buttons {
                flex-direction: column;
            }
            
            .filter-btn {
                width: 100%;
            }
        }

        /* Locked entries */
        .term-card.locked {
            cursor: default;
            border-style: dashed;
            opacity: 0.55;
        }

        .term-card.locked:hover {
            border-color: #333;
            background: rgba(0, 255, 65, 0.02);
            box-shadow: none;
        }

        .term-card.locked .term-name {
            color: #555;
            letter-spacing: 2px;
        }

        .section-intro {
            grid-column: 1 / -1;
            font-size: 13px;
            color: #aaa;
            line-height: 1.7;
            margin: -10px 0 5px 8px;
            max-width: 900px;
        }

        /* Entry body */
        .entry-block {
            margin-bottom: 18px;
        }

        .entry-label {
            color: #ffaa00;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }

        .entry-line + .entry-line {
            margin-top: 10px;
        }

        .entry-line strong {
            color: #00ff41;
            font-weight: normal;
        }

        .entry-line em {
            color: #bbb;
        }

        .entry-list {
            list-style: none;
        }

        .entry-list li {
            position: relative;
            padding-left: 18px;
            margin-bottom: 6px;
        }

        .entry-list li::before {
            content: '›';
            position: absolute;
            left: 2px;
            color: #00ff41;
        }

        .modal-term-definition .code-snippet {
            margin-bottom: 18px;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Header -->
        <div class="glossary-header">
            <div class="glossary-title">Glossary</div>
            <a href="/terminal" class="nav-button">← Return to Terminal</a>
        </div>

        <!-- Search & Filters -->
        <div class="controls">
            <input
                type="text"
                id="search-input"
                class="search-bar"
                placeholder="Search terminology, functions, entities..."
                autocomplete="off"
            >

            <div class="filter-buttons">
                {glossary.sections.map((s) => (
                    <button class="filter-btn" data-category={s.id}>{s.title}</button>
                ))}
                <button class="filter-btn" data-category="all">All</button>
                <button id="clear-btn" style="background: transparent; border: 1px solid #ff4444; color: #ff4444; padding: 8px 16px; font-family: 'Share Tech Mono', monospace; font-size: 12px; cursor: pointer; transition: all 0.3s; text-transform: uppercase; letter-spacing: 1px; margin-left: 10px;">CLEAR</button>
            </div>
        </div>

        <!-- Results Info -->
        <div class="results-info" id="results-info">
            Showing <span class="count" id="results-count">0</span> entries
        </div>

        <!-- Empty State -->
        <div id="empty-state" style="text-align: center; padding: 80px 40px; color: #666; display: block;">
            <div style="font-size: 14px; margin-bottom: 15px; color: #888;">Use search or select a category above to view glossary entries</div>
            <div style="font-size: 12px;" id="unlock-summary"></div>
        </div>

        <!-- Term Grid -->
        <div class="term-grid" id="term-grid" style="display: none;"></div>

        <!-- No Results -->
        <div class="no-results" id="no-results" style="display: none;">
            <div class="no-results-icon">🔍</div>
            <div>No unlocked entries match your search.</div>
        </div>
    </div>

    <!-- Term Detail Modal -->
    <div id="term-modal" class="modal">
        <div class="modal-content">
            <button class="modal-close" id="modal-close">✕ CLOSE</button>
            <div id="modal-body"></div>
        </div>
    </div>

    <script type="application/json" id="glossary-data" set:html={glossaryJson}></script>

    <script>
        import {
            CHAPLET_ORDER,
            filterEntry,
            isUnlockedAt,
            type Entry,
            type Line,
            type Section,
            type Unlock,
        } from "../data/glossary-visibility.ts";

        const data = JSON.parse(document.getElementById("glossary-data")!.textContent!) as {
            sections: Section[];
            entries: Entry[];
        };

        // ==========================================
        // UNLOCKS
        // An entry opens once the reader has FINISHED its chaplet
        // (h2e_<id>_completed, set by the reader's mark-finished button).
        // ==========================================
        function furthestFinished(): string {
            let furthest = "";
            try {
                for (const id of CHAPLET_ORDER) {
                    if (localStorage.getItem(`h2e_${id}_completed`)) furthest = id;
                }
            } catch {
                // Storage blocked: nothing is unlocked.
            }
            return furthest;
        }

        const reached = furthestFinished();
        const open = (u?: Unlock) => isUnlockedAt(u, reached);
        const sectionTitle = new Map(data.sections.map((s) => [s.id, s.title]));
        const visible = new Map<string, Entry>();
        for (const e of data.entries) {
            const v = filterEntry(e, open);
            if (v) visible.set(e.id, v);
        }

        const chapletLabel = (u: Unlock) => `Chaplet ${u.replace("chaplet", "").replace(/^(\d)5$/, "$1.5")}`;

        // ==========================================
        // TEXT
        // ==========================================
        const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        const inline = (s: string) =>
            esc(s).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>").replace(/\*(.+?)\*/g, "<em>$1</em>");
        const lineText = (line: Line) => line.map((s) => s.t).join("");
        const plain = (s: string) => s.replace(/\*\*|\*/g, "").trim();

        function entryText(e: Entry): string {
            return e.blocks
                .flatMap((b) => (b.type === "list" ? b.items : b.lines))
                .map((l) => plain(lineText(l)))
                .join(" ");
        }

        function shortText(e: Entry): string {
            for (const b of e.blocks) {
                if (b.type === "pseudo") continue;
                for (const l of b.type === "list" ? b.items : b.lines) {
                    const t = lineText(l).trim();
                    if (!t || t.startsWith("Pronunciation:") || t.startsWith("**")) continue;
                    return plain(t);
                }
            }
            return "";
        }

        function entryBody(e: Entry): string {
            return e.blocks
                .map((b) => {
                    if (b.type === "list") {
                        return `<ul class="entry-block entry-list">${b.items.map((l) => `<li class="entry-line">${inline(lineText(l))}</li>`).join("")}</ul>`;
                    }
                    if (b.type === "pseudo") {
                        const code = b.lines
                            .map((l) => {
                                const t = esc(lineText(l));
                                return t.trim().startsWith("//") ? `<span class="code-comment">${t}</span>` : t;
                            })
                            .join("\n");
                        return `<div class="code-snippet">${code}</div>`;
                    }
                    const lines = b.lines
                        .map((l) => {
                            const t = lineText(l).trim();
                            return /^\*\*[^*]+\*\*$/.test(t)
                                ? `<div class="entry-label">${esc(plain(t))}</div>`
                                : `<div class="entry-line">${inline(t)}</div>`;
                        })
                        .join("");
                    return `<div class="entry-block">${lines}</div>`;
                })
                .join("");
        }

        // ==========================================
        // STATE
        // ==========================================
        let currentFilter = "all";
        let currentSearch = "";
        let hasInteracted = false; // Track if user has searched or filtered

        const grid = document.getElementById("term-grid")!;
        const noResults = document.getElementById("no-results")!;
        const emptyState = document.getElementById("empty-state")!;
        const resultsCount = document.getElementById("results-count")!;

        document.getElementById("unlock-summary")!.textContent =
            `${visible.size} of ${data.entries.length} entries unlocked across ${data.sections.length} sections`;

        // ==========================================
        // RENDER
        // ==========================================
        function buildCardHTML(e: Entry): string {
            const v = visible.get(e.id);
            const category = esc(sectionTitle.get(e.section) ?? "");
            if (!v) {
                return `
                    <div class="term-card locked">
                        <div class="term-category">[${category.toUpperCase()}]</div>
                        <div class="term-name">[REDACTED]</div>
                        <div class="term-short">Unlocks when you finish ${chapletLabel(e.unlock)}.</div>
                    </div>`;
            }
            const codeBadge = v.blocks.some((b) => b.type === "pseudo") ? '<span class="has-code-badge">Code</span>' : "";
            return `
                <div class="term-card" data-entry="${e.id}">
                    <div class="term-category">[${category.toUpperCase()}]</div>
                    <div class="term-name">${esc(e.title)}${codeBadge}</div>
                    <div class="term-short">${esc(shortText(v))}</div>
                </div>`;
        }

        function sectionIntro(s: Section): string {
            if (!s.intro) return "";
            return `<div class="section-intro">${s.intro.map((p) => p.map((l) => inline(lineText(l))).join("<br>")).join("<br><br>")}</div>`;
        }

        function renderTerms() {
            if (!hasInteracted) {
                grid.style.display = "none";
                noResults.style.display = "none";
                emptyState.style.display = "block";
                resultsCount.textContent = "0";
                return;
            }
            emptyState.style.display = "none";

            let entries = data.entries.filter((e) => currentFilter === "all" || e.section === currentFilter);

            // Search only looks at unlocked entries and unlocked text.
            if (currentSearch) {
                const q = currentSearch.toLowerCase();
                entries = entries.filter((e) => {
                    const v = visible.get(e.id);
                    return v && (v.title.toLowerCase().includes(q) || entryText(v).toLowerCase().includes(q));
                });
            }

            resultsCount.textContent = String(entries.length);
            if (entries.length === 0) {
                grid.style.display = "none";
                noResults.style.display = "block";
                return;
            }
            grid.removeAttribute("style");
            noResults.style.display = "none";

            if (currentSearch) {
                grid.innerHTML = entries.map(buildCardHTML).join("");
                return;
            }
            // Group under the Glossary's own section headers.
            grid.innerHTML = data.sections
                .map((s) => {
                    const items = entries.filter((e) => e.section === s.id);
                    if (!items.length) return "";
                    const unlocked = items.filter((e) => visible.has(e.id)).length;
                    return `
                        <div class="section-divider">
                            <span class="section-title">→ ${esc(s.title)}</span>
                            <span class="section-count">(${unlocked} of ${items.length} unlocked)</span>
                        </div>
                        ${sectionIntro(s)}
                        ${items.map(buildCardHTML).join("")}`;
                })
                .join("");
        }

        function showEntry(id: string) {
            const v = visible.get(id);
            if (!v) return;
            document.getElementById("modal-body")!.innerHTML = `
                <div class="modal-term-name">${esc(v.title)}</div>
                <div class="modal-term-category">${esc(sectionTitle.get(v.section) ?? "")}</div>
                <div class="modal-term-definition">${entryBody(v)}</div>`;
            document.getElementById("term-modal")!.classList.add("active");
        }

        function closeModal() {
            document.getElementById("term-modal")!.classList.remove("active");
        }

        // ==========================================
        // EVENT LISTENERS
        // ==========================================
        grid.addEventListener("click", (e) => {
            const card = (e.target as HTMLElement).closest<HTMLElement>(".term-card[data-entry]");
            if (card) showEntry(card.dataset.entry!);
        });

        document.getElementById("clear-btn")!.addEventListener("click", () => {
            (document.getElementById("search-input") as HTMLInputElement).value = "";
            currentSearch = "";
            currentFilter = "all";
            hasInteracted = false;
            document.querySelectorAll(".filter-btn").forEach((b) => b.classList.remove("active"));
            grid.innerHTML = "";
            renderTerms();
        });

        document.getElementById("search-input")!.addEventListener("input", (e) => {
            currentSearch = (e.target as HTMLInputElement).value;
            hasInteracted = true;
            renderTerms();
        });

        document.querySelectorAll<HTMLButtonElement>(".filter-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                document.querySelectorAll(".filter-btn").forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");
                currentFilter = btn.dataset.category!;
                hasInteracted = true;
                renderTerms();
            });
        });

        document.getElementById("modal-close")!.addEventListener("click", closeModal);

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && document.getElementById("term-modal")!.classList.contains("active")) {
                closeModal();
            }
        });

        document.getElementById("term-modal")!.addEventListener("click", (e) => {
            if ((e.target as HTMLElement).id === "term-modal") closeModal();
        });

        renderTerms(); // Starts on the empty state until the reader searches or filters.
    </script>

</body>
</html>
