---
// Glossary - System Terminology Database
// Last Updated: January 9, 2026
const siteTitle = "H2E Framework - Glossary";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{siteTitle}</title>
    <style is:global>
        @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Courier+Prime:wght@400;700&display=swap');
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Share Tech Mono', 'Courier New', monospace;
            background: #0a0a0a;
            color: #00ff41;
            line-height: 1.6;
            padding: 30px;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
        }
        
        /* Header */
        .glossary-header {
            border: 1px solid #00ff41;
            padding: 20px;
            margin-bottom: 40px;
            background: rgba(0, 255, 65, 0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .glossary-title {
            font-size: 24px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        
        .nav-button {
            display: inline-block;
            padding: 10px 20px;
            border: 1px solid #00ff41;
            background: transparent;
            color: #00ff41;
            font-size: 11px;
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.3s;
            font-family: 'Share Tech Mono', monospace;
        }
        
        .nav-button:hover {
            background: rgba(0, 255, 65, 0.1);
            box-shadow: 0 0 15px rgba(0, 255, 65, 0.3);
        }
        
        /* Search & Filters */
        .controls {
            margin-bottom: 40px;
        }
        
        .search-bar {
            max-width: 500px;
            background: #000;
            border: 1px solid #00ff41;
            color: #00ff41;
            padding: 15px 20px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 14px;
            margin-bottom: 20px;
            outline: none;
        }
        
        .search-bar::placeholder {
            color: #666;
        }
        
        .search-bar:focus {
            box-shadow: 0 0 10px rgba(0, 255, 65, 0.3);
        }
        
        .filter-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        .filter-btn {
            background: transparent;
            border: 1px solid #333;
            color: #888;
            padding: 8px 16px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .filter-btn:hover {
            border-color: #00ff41;
            color: #00ff41;
        }
        
        .filter-btn.active {
            background: rgba(0, 255, 65, 0.1);
            border-color: #00ff41;
            color: #00ff41;
        }
        
        /* Results Info */
        .results-info {
            font-size: 12px;
            color: #666;
            margin-bottom: 20px;
        }
        
        .results-info .count {
            color: #00ff41;
        }
        
        /* Term Grid */
        .term-grid {
            display: grid !important;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)) !important;
            gap: 25px;
            margin-bottom: 40px;
        }
        
        /* Section Headers (like Registry) */
        .section-divider {
            grid-column: 1 / -1;
            margin: 30px 0 20px 0;
            padding-left: 5px;
            border-left: 3px solid #ffaa00;
        }
        
        .section-divider:first-child {
            margin-top: 0;
        }
        
        .section-title {
            font-size: 14px;
            color: #ffaa00;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: bold;
        }
        
        .section-count {
            font-size: 11px;
            color: #666;
            margin-left: 10px;
        }
        
        /* Term Card */
        .term-card {
            border: 1px solid #333;
            background: rgba(0, 255, 65, 0.02);
            padding: 20px;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
            min-height: 120px;
        }
        
        .term-card:hover {
            border-color: #00ff41;
            background: rgba(0, 255, 65, 0.05);
            box-shadow: 0 0 15px rgba(0, 255, 65, 0.2);
        }
        
        .term-card.coming-soon {
            opacity: 0.5;
            cursor: default;
        }
        
        .term-card.coming-soon:hover {
            border-color: #333;
            background: rgba(0, 255, 65, 0.02);
            box-shadow: none;
        }
        
        .term-category {
            font-size: 10px;
            color: #ffaa00;
            background: rgba(255, 170, 0, 0.1);
            border: 1px solid rgba(255, 170, 0, 0.3);
            padding: 4px 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
            display: inline-block;
        }
        
        .term-name {
            font-size: 18px;
            color: #00ff41;
            margin-bottom: 12px;
        }
        
        .term-short {
            font-size: 12px;
            color: #888;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        .coming-soon-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 9px;
            color: #666;
            background: rgba(255, 170, 0, 0.1);
            border: 1px solid #333;
            padding: 3px 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .has-code-badge {
            display: inline-block;
            font-size: 9px;
            color: #00d9ff;
            background: rgba(0, 217, 255, 0.1);
            border: 1px solid #00d9ff;
            padding: 2px 6px;
            margin-left: 8px;
            text-transform: uppercase;
        }
        
        /* No Results */
        .no-results {
            text-align: center;
            padding: 60px 20px;
            color: #666;
        }
        
        .no-results-icon {
            font-size: 48px;
            margin-bottom: 20px;
            opacity: 0.3;
        }
        
        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 10001;
            overflow-y: auto;
            padding: 40px 20px;
        }
        
        .modal.active {
            display: block;
        }
        
        .modal-content {
            max-width: 900px;
            margin: 0 auto;
            border: 1px solid #00ff41;
            padding: 40px;
            background: #0a0a0a;
            position: relative;
        }
        
        .modal-close {
            position: absolute;
            top: 15px;
            right: 15px;
            background: none;
            border: 1px solid #00ff41;
            color: #00ff41;
            padding: 5px 15px;
            cursor: pointer;
            font-family: inherit;
            font-size: 12px;
            transition: all 0.3s;
        }
        
        .modal-close:hover {
            background: rgba(0, 255, 65, 0.2);
        }
        
        .modal-term-name {
            font-size: 28px;
            color: #00ff41;
            margin-bottom: 10px;
        }
        
        .modal-term-category {
            font-size: 11px;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 25px;
        }
        
        .modal-term-definition {
            font-size: 14px;
            color: #ddd;
            line-height: 1.8;
            margin-bottom: 30px;
        }
        
        .code-snippet-section {
            margin-top: 30px;
        }
        
        .code-snippet-title {
            font-size: 12px;
            color: #00d9ff;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .code-snippet {
            background: #000;
            border: 1px solid #00d9ff;
            padding: 20px;
            font-family: 'Courier Prime', 'Courier New', monospace;
            font-size: 13px;
            color: #00d9ff;
            line-height: 1.6;
            overflow-x: auto;
            white-space: pre;
        }
        
        .code-comment {
            color: #666;
        }
        
        @media (max-width: 768px) {
            .term-grid {
                grid-template-columns: 1fr;
            }
            
            .filter-buttons {
                flex-direction: column;
            }
            
            .filter-btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Header -->
        <div class="glossary-header">
            <div class="glossary-title">Glossary</div>
            <a href="/terminal" class="nav-button">← Return to Terminal</a>
        </div>

        <!-- Search & Filters -->
        <div class="controls">
            <input 
                type="text" 
                id="search-input" 
                class="search-bar" 
                placeholder="Search terminology, functions, entities..."
                autocomplete="off"
            >
            
            <div class="filter-buttons">
                <button class="filter-btn" data-category="function">Functions</button>
                <button class="filter-btn" data-category="terminology">Terminology</button>
                <button class="filter-btn" data-category="praetores">Praetores</button>
                <button class="filter-btn" data-category="concept">Concepts</button>
                <button class="filter-btn" data-category="all">All</button>
                <button id="clear-btn" style="background: transparent; border: 1px solid #ff4444; color: #ff4444; padding: 8px 16px; font-family: 'Share Tech Mono', monospace; font-size: 12px; cursor: pointer; transition: all 0.3s; text-transform: uppercase; letter-spacing: 1px; margin-left: 10px;">CLEAR</button>
            </div>
        </div>

        <!-- Results Info -->
        <div class="results-info" id="results-info">
            Showing <span class="count" id="results-count">0</span> entries
        </div>
        
        <!-- Empty State -->
        <div id="empty-state" style="text-align: center; padding: 80px 40px; color: #666; display: block;">
            <div style="font-size: 14px; margin-bottom: 15px; color: #888;">Use search or select a category above to view glossary entries</div>
            <div style="font-size: 12px;">23 terms available across 4 categories</div>
        </div>

        <!-- Term Grid -->
        <div class="term-grid" id="term-grid" style="display: none;">
            <!-- Terms will be rendered here by JavaScript -->
        </div>

        <!-- No Results -->
        <div class="no-results" id="no-results" style="display: none;">
            <div class="no-results-icon">🔍</div>
            <div>No entries found matching your search.</div>
        </div>
    </div>

    <!-- Term Detail Modal -->
    <div id="term-modal" class="modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal()">✕ CLOSE</button>
            <div id="modal-body"></div>
        </div>
    </div>

    <script is:inline>
        console.log('Glossary Version: 2026-01-09-19:10:00 - NAV POLISH');
        console.log('Script loading...');

        // ==========================================
        // GLOSSARY DATA
        // ==========================================
        // To add new entries, just add objects to this array!
        
        const glossaryData = [
            // FUNCTIONS
            {
                term: 'AssignareFatum()',
                category: 'function',
                shortDef: 'System function that assigns each PreBorn to Born() or Perish().',
                fullDef: 'System-level function that assigns each PreBorn to one of two fates: Born() or Perish(). Once called, the assignment becomes part of the Life Book but does not trigger execution immediately. Fate assignment does not guarantee successful execution—biological, emotional, or systemic instability during gestation may lead to early termination.',
                codeSnippet: `// Assigns fate to a PreBorn based on mother status
function AssignareFatum(entity) {
    if (entity.MotherStatus == "Alive") {
        return Born(entity); // Mother lives, child is born
    } else {
        return Perish(entity); // Mother dies, child perishes
    }
}`
            },
            {
                term: 'ApostasiaVitae()',
                category: 'function',
                shortDef: 'Forbidden function for mortal self-termination. Cross-framework contamination.',
                fullDef: 'A rare, anomalous function believed to originate outside the current Framework. It self-terminates a rendered entity and is associated with mortal suicide. Its logic appears incompatible with existing code protocols, suggesting cross-framework contamination. Forbidden. Active. Irreversible. This function was NOT authored by the H2E system.',
                codeSnippet: `// Handles self-termination (suicide) of a mortal
// Separate from MortalExpire() which handles natural deaths
function ApostasiaVitae(entity) {
    if (entity.isMortal && entity.initiatesSelfTermination) {
        log("ApostasiaVitae() invoked for " + entity.name);
        
        // Check if divine intervention applies
        if (Intercede(entity)) {
            return OverrideFate(entity);
        }
        
        deleteFromFramework(entity);
        return null;
    }
}`
            },
            {
                term: 'Born()',
                category: 'function',
                shortDef: 'Execution function for PreBorn marked for life. Initiates pregnancy and rendering.',
                fullDef: 'A function that, when executed, initiates rendering of a construct into mortal form. While the system treats this as the beginning of life on Earth, its invocation may not always succeed - errors, failures, and interruptions are possible. Binds PreBorn to a Mortal Parent via a mother reference, establishing a dependency that strengthens during gestation.',
                codeSnippet: `// Instantiates a PreBorn entity into the physical world
// Only executed if AssignareFatum() designates entity as Born
function Born(entity) {
    entity.status = "Living";
    instantiate(entity); // Triggers actual birth event
    return entity;
}`
            },
            {
                term: 'Perish()',
                category: 'function',
                shortDef: 'Permanently deletes a PreBorn entity before instantiation.',
                fullDef: 'A function that halts or denies the execution of Born(). It may occur due to miscarriage, stillbirth, system error, override, or cancellation. Perish() does not erase all traces; sometimes fragments remain - ghost threads the system never fully purges.',
                codeSnippet: `// Permanently deletes a PreBorn entity
// Executed if AssignareFatum() designates entity for deletion
function Perish(entity) {
    log("Perishing entity: " + entity.name);
    deleteFromFramework(entity);
    return null;
}`
            },

            // TERMINOLOGY
            {
                term: 'H2E Framework',
                category: 'terminology',
                shortDef: 'The vast inherited codebase through which fate is rendered, executed, or denied.',
                fullDef: 'A vast, inherited codebase through which fate is rendered, executed, or denied. Its original authorship is unknown. Obeyed by Functionaries. Enforced by the Praetores. Studied by a few and questioned by those who have seen its flaws. The Framework was abandoned by its deprecated Creator and left to decay, now run by the Praetores who enforce code they did not write.',
                codeSnippet: null
            },
            {
                term: 'PreBorn',
                category: 'terminology',
                shortDef: 'Unresolved constructs awaiting designation: Born() or Perish().',
                fullDef: 'The PreBorn are unresolved constructs, potential mortal threads held within system memory but not yet instantiated. They exist in a suspended state between two possible function calls: Born() or Perish(). Though technically not rendered, PreBorn possess awareness. They think. They choose. They ache. They are close enough to be human, but not close enough to be real.',
                codeSnippet: null
            },
            {
                term: 'Life Book (LB)',
                category: 'terminology',
                shortDef: 'A mortals procedural timeline, written in code.',
                fullDef: 'A mortals procedural timeline, written in code. Instantiated at the execution of Born(). May be amended by Praetores, monitored by trinus, and - on rare occasions - interrupted. Contains syntax both active and deprecated, including untraceable entries. The current version is LB 3.2, which inadvertently exposed mortal Life Books to lower-tier functionaries.',
                codeSnippet: null
            },
            {
                term: 'Terminal 13.7',
                category: 'terminology',
                shortDef: 'A remote access node at the edge of I/O. trinus workspace.',
                fullDef: 'A remote access node used by trinus, located on the edge of the I/O plane. The number is symbolic - referencing both the cosmic constant and a point of recursion. Its where decisions stall. Forgotten. Never repaired. Never erased. Ozone hangs heavy, mixing with the stale scent of burnt circuits. This is where fate assignments are processed.',
                codeSnippet: null
            },

            // PRAETORES
            {
                term: 'theWitnesses',
                category: 'praetores',
                shortDef: 'Praetor pair. Execute Born(), Perish(), Obliviate(). Final arbiters.',
                fullDef: 'theWitnesses are the active executors of fate within the Praetores class. They appear exclusively in pairs, maintaining dual-voice harmony when executing methods such as Born(), Perish(), and Obliviate(). Their presence is unwavering, and their logic unyielding. Vitus (male) initiates fates, from Latin "vita" meaning life. Mora (female) represents the delay before execution, from Latin "mora" meaning pause.',
                codeSnippet: null
            },
            {
                term: 'theGuardians',
                category: 'praetores',
                shortDef: 'Praetor pair. Enforce system flow, correct execution delays.',
                fullDef: 'Active executors of flow and correction within the Praetores class. They enforce continuity, issue system resets, and ensure function propagation across the I/O stream. Cale (male) derived from "caelum" meaning sky/heaven—implies high authority and untouchable calm. Numa (female) from Numa Pompilius, the Roman king who codified laws and rituals—symbol of sacred law and ritual.',
                codeSnippet: null
            },

            // COMING SOON - Functions
            {
                term: 'Intercede()',
                category: 'function',
                shortDef: 'Coming Soon',
                fullDef: null,
                comingSoon: true
            },
            {
                term: 'Rollback()',
                category: 'function',
                shortDef: 'Coming Soon',
                fullDef: null,
                comingSoon: true
            },
            {
                term: 'Obliviate()',
                category: 'function',
                shortDef: 'Coming Soon',
                fullDef: null,
                comingSoon: true
            },
            {
                term: 'MortalExpire()',
                category: 'function',
                shortDef: 'Coming Soon',
                fullDef: null,
                comingSoon: true
            },

            // COMING SOON - Terminology
            {
                term: 'Glitch',
                category: 'terminology',
                shortDef: 'Coming Soon',
                fullDef: null,
                comingSoon: true
            },
            {
                term: 'Deprecated',
                category: 'terminology',
                shortDef: 'Coming Soon',
                fullDef: null,
                comingSoon: true
            },
            {
                term: 'Ghost Relays',
                category: 'terminology',
                shortDef: 'Coming Soon',
                fullDef: null,
                comingSoon: true
            },

            // COMING SOON - Praetores
            {
                term: 'theScribes',
                category: 'praetores',
                shortDef: 'Coming Soon',
                fullDef: null,
                comingSoon: true
            },
            {
                term: 'theJudicants',
                category: 'praetores',
                shortDef: 'Coming Soon',
                fullDef: null,
                comingSoon: true
            },
            {
                term: 'theKeepers',
                category: 'praetores',
                shortDef: 'Coming Soon',
                fullDef: null,
                comingSoon: true
            },
            {
                term: 'theFell',
                category: 'praetores',
                shortDef: 'Coming Soon',
                fullDef: null,
                comingSoon: true
            },

            // COMING SOON - Concepts
            {
                term: 'Origin Logic',
                category: 'concept',
                shortDef: 'Coming Soon',
                fullDef: null,
                comingSoon: true
            },
            {
                term: 'Cross-Framework Function',
                category: 'concept',
                shortDef: 'Coming Soon',
                fullDef: null,
                comingSoon: true
            }
        ];
        
        console.log('glossaryData loaded:', glossaryData.length, 'entries');

        // ==========================================
        // STATE
        // ==========================================
        let currentFilter = 'all';
        let currentSearch = '';
        let hasInteracted = false; // Track if user has searched or filtered

        // ==========================================
        // RENDER FUNCTIONS
        // ==========================================
        function renderTerms() {
            console.log('renderTerms called');
            const grid = document.getElementById('term-grid');
            const noResults = document.getElementById('no-results');
            const emptyState = document.getElementById('empty-state');
            
            console.log('Grid element:', grid);
            console.log('Current filter:', currentFilter);
            console.log('Current search:', currentSearch);
            console.log('Has interacted:', hasInteracted);
            
            // Show empty state if no interaction yet
            if (!hasInteracted) {
                grid.style.display = 'none';
                noResults.style.display = 'none';
                emptyState.style.display = 'block';
                document.getElementById('results-count').textContent = 0;
                return;
            }
            
            // Hide empty state once user interacts
            emptyState.style.display = 'none';
            
            // Filter data - keep track of original indices
            let filtered = glossaryData.map((term, index) => ({ term, index }));
            console.log('After mapping:', filtered.length);
            
            // Apply category filter
            if (currentFilter !== 'all') {
                filtered = filtered.filter(item => item.term.category === currentFilter);
            }
            
            // Apply search filter
            if (currentSearch) {
                const searchLower = currentSearch.toLowerCase();
                filtered = filtered.filter(item => {
                    const term = item.term;
                    return term.term.toLowerCase().includes(searchLower) ||
                        (term.shortDef && term.shortDef.toLowerCase().includes(searchLower)) ||
                        (term.fullDef && term.fullDef.toLowerCase().includes(searchLower));
                });
            }
            
            // Update results count
            console.log('Filtered count:', filtered.length);
            document.getElementById('results-count').textContent = filtered.length;
            
            // Show/hide no results
            if (filtered.length === 0) {
                grid.style.display = 'none';
                noResults.style.display = 'block';
                return;
            } else {
                grid.removeAttribute('style'); // Completely remove inline style
                noResults.style.display = 'none';
                
                // DEBUG: Log computed styles
                console.log('📊 Grid display after removing style attribute');
                const computedStyle = window.getComputedStyle(grid);
                console.log('📊 Computed display:', computedStyle.display);
                console.log('📊 Computed grid-template-columns:', computedStyle.gridTemplateColumns);
                console.log('📊 Window width:', window.innerWidth);
            }
            
            // Group by category if showing ALL
            if (currentFilter === 'all' && !currentSearch) {
                renderGroupedSections(filtered);
            } else {
                renderCards(filtered);
            }
        }
        
        // Render with section headers (Registry style)
        function renderGroupedSections(filtered) {
            const grid = document.getElementById('term-grid');
            
            const categories = {
                'function': { title: 'FUNCTIONS', items: [] },
                'terminology': { title: 'TERMINOLOGY', items: [] },
                'praetores': { title: 'PRAETORES', items: [] },
                'concept': { title: 'CONCEPTS', items: [] }
            };
            
            // Group items by category
            filtered.forEach(item => {
                const cat = item.term.category;
                if (categories[cat]) {
                    categories[cat].items.push(item);
                }
            });
            
            // Build HTML with sections - headers span full row
            let html = '';
            Object.keys(categories).forEach(catKey => {
                const cat = categories[catKey];
                if (cat.items.length > 0) {
                    html += `
                        <div class="section-divider">
                            <span class="section-title">→ ${cat.title}</span>
                            <span class="section-count">(${cat.items.length} entries)</span>
                        </div>
                    `;
                    
                    cat.items.forEach(item => {
                        html += buildCardHTML(item);
                    });
                }
            });
            
            grid.innerHTML = html;
            attachCardListeners();
        }
        
        // Render flat list of cards
        function renderCards(filtered) {
            const grid = document.getElementById('term-grid');
            grid.innerHTML = filtered.map(item => buildCardHTML(item)).join('');
            attachCardListeners();
        }
        
        // Build card HTML
        function buildCardHTML(item) {
            const term = item.term;
            const index = item.index;
            const comingSoonClass = term.comingSoon ? 'coming-soon' : '';
            const comingSoonBadge = term.comingSoon ? '<div class="coming-soon-badge">Coming Soon</div>' : '';
            const codeBadge = term.codeSnippet ? '<span class="has-code-badge">Code</span>' : '';
            const dataIndex = term.comingSoon ? '' : `data-term-index="${index}"`;
            
            return `
                <div class="term-card ${comingSoonClass}" ${dataIndex}>
                    ${comingSoonBadge}
                    <div class="term-category">[${term.category.toUpperCase()}]</div>
                    <div class="term-name">${term.term}${codeBadge}</div>
                    <div class="term-short">${term.shortDef}</div>
                </div>
            `;
        }
        
        // Attach event listeners to cards
        function attachCardListeners() {
            const grid = document.getElementById('term-grid');
            grid.querySelectorAll('.term-card[data-term-index]').forEach(card => {
                card.addEventListener('click', function() {
                    const index = parseInt(this.getAttribute('data-term-index'));
                    showTermByIndex(index);
                });
            });
        }

        function showTerm(termName) {
            const term = glossaryData.find(t => t.term === termName);
            if (!term || term.comingSoon) return;

            const codeSection = term.codeSnippet ? `
                <div class="code-snippet-section">
                    <div class="code-snippet-title">Code Example</div>
                    <div class="code-snippet">${term.codeSnippet}</div>
                </div>
            ` : '';

            document.getElementById('modal-body').innerHTML = `
                <div class="modal-term-name">${term.term}</div>
                <div class="modal-term-category">${term.category}</div>
                <div class="modal-term-definition">${term.fullDef}</div>
                ${codeSection}
            `;

            document.getElementById('term-modal').classList.add('active');
        }

        // Show term by index (avoids quote escaping issues)
        window.showTermByIndex = function(index) {
            const term = glossaryData[index];
            if (!term || term.comingSoon) return;
            showTerm(term.term);
        };

        function closeModal() {
            document.getElementById('term-modal').classList.remove('active');
        }

        // ==========================================
        // EVENT LISTENERS
        // ==========================================
        
        // Clear button
        document.getElementById('clear-btn').addEventListener('click', () => {
            console.log('🧹 CLEAR clicked');
            document.getElementById('search-input').value = '';
            currentSearch = '';
            currentFilter = 'all';
            hasInteracted = false;
            
            // Remove all button highlighting
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            
            // Clear grid content
            document.getElementById('term-grid').innerHTML = '';
            
            // Show empty state, hide grid and no-results
            document.getElementById('empty-state').style.display = 'block';
            document.getElementById('term-grid').style.display = 'none';
            document.getElementById('no-results').style.display = 'none';
            document.getElementById('results-count').textContent = '0';
        });
        
        // Search
        document.getElementById('search-input').addEventListener('input', (e) => {
            currentSearch = e.target.value;
            hasInteracted = true;
            renderTerms();
        });

        // Category filters
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                // Update active state
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                
                // Update filter
                currentFilter = btn.dataset.category;
                hasInteracted = true;
                renderTerms();
            });
        });

        // Close modal on Escape
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && document.getElementById('term-modal').classList.contains('active')) {
                closeModal();
            }
        });

        // Close modal when clicking outside
        document.getElementById('term-modal').addEventListener('click', (e) => {
            if (e.target.id === 'term-modal') {
                closeModal();
            }
        });

        // ==========================================
        // INITIALIZE
        // ==========================================
        // Start with empty state - wait for user interaction
        renderTerms(); // Will show empty state since hasInteracted = false
    </script>

</body>
</html>
