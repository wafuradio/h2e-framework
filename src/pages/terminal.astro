---
// =============================================================================
// TERMINAL 13.7 - MAIN STORY INTERFACE
// =============================================================================
// This is the main terminal page where users read the story
// Session-based boot skip implementation
// Last Updated: January 21, 2026
// =============================================================================

const siteTitle = "H2E Framework - Terminal 13.7";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta
            http-equiv="Cache-Control"
            content="no-cache, no-store, must-revalidate"
        />
        <meta http-equiv="Pragma" content="no-cache" />
        <meta http-equiv="Expires" content="0" />
        <title>{siteTitle}</title>

        <!-- Cloudflare Web Analytics -->
        <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "c17e7ed80ead4b1580e4eb1e42fc29fa"}'></script><!-- End Cloudflare Web Analytics -->
        
        <style>
            /*  =================================================================
            FONTS & GLOBAL RESETS
            ================================================================= */
            @import url("https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Courier+Prime:wght@400;700&family=Lora:ital,wght@0,400;0,700;1,400&display=swap");

            /* Remove default browser spacing and set consistent box-sizing */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            /* =================================================================
           BODY - BASE STYLING FOR ENTIRE PAGE
           ================================================================= */
            body {
                font-family: "Share Tech Mono", "Courier New", monospace;
                background: #0a0a0a; /* Very dark background */
                color: #00ff41; /* Terminal green text */
                overflow-x: hidden; /* Prevent horizontal scrolling */
                line-height: 1.6;
            }

            /* =================================================================
           BOOT SEQUENCE SCREEN
           This is the first thing users see when they visit
           Shows "H2E FRAMEWORK v3.2" loading text
           ================================================================= */
            #boot-sequence {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100vh;
                background: #000;
                z-index: 9999; /* Sits on top of everything */
                display: flex;
                align-items: center;
                justify-content: center;
                flex-direction: column;
            }

            /* Hide the boot sequence when .hidden class is added */
            #boot-sequence.hidden {
                display: none;
            }

            /* Individual boot text lines that fade in */
            .boot-text {
                font-size: 14px;
                margin: 5px 0;
                opacity: 0;
                animation: fadeIn 0.5s forwards;
            }

            /* Stagger the fade-in timing for each line */
            .boot-text:nth-child(1) {
                animation-delay: 0.5s;
            }
            .boot-text:nth-child(2) {
                animation-delay: 1s;
            }
            .boot-text:nth-child(3) {
                animation-delay: 1.5s;
            }
            .boot-text:nth-child(4) {
                animation-delay: 2s;
            }
            .boot-text:nth-child(5) {
                animation-delay: 2.5s;
            }
            .boot-text:nth-child(6) {
                animation-delay: 3s;
            }
            .boot-text:nth-child(7) {
                animation-delay: 3.5s;
            }

            /* Progress bar during boot */
            .progress-bar {
                width: 300px;
                height: 20px;
                border: 1px solid #00ff41;
                margin: 20px 0;
                opacity: 0;
                animation: fadeIn 0.5s forwards 4s;
            }

            /* The green fill inside the progress bar */
            .progress-fill {
                height: 100%;
                background: #00ff41;
                width: 0%;
                animation: fillProgress 2s forwards 4s;
            }

            /* Fade in animation */
            @keyframes fadeIn {
                to {
                    opacity: 1;
                }
            }

            /* Progress bar fill animation */
            @keyframes fillProgress {
                to {
                    width: 100%;
                }
            }

            /* Subtle scanline effect for ghost feed */
            @keyframes scanline {
                0% {
                    transform: translateY(-100%);
                }
                100% {
                    transform: translateY(100%);
                }
            }

            /* =================================================================
           ENTER TERMINAL SCREEN
           This shows after boot sequence completes
           Has the big "ENTER TERMINAL" button
           ================================================================= */
            #enter-terminal-screen {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100vh;
                background: #000;
                z-index: 9998; /* Just below boot sequence */
                display: none; /* Hidden by default */
                align-items: center;
                justify-content: center;
                flex-direction: column;
                transition: opacity 0.5s;
            }

            /* Show the enter terminal screen when .active is added */
            #enter-terminal-screen.active {
                display: flex;
            }

            /* Fade out when .hidden is added */
            #enter-terminal-screen.hidden {
                opacity: 0;
                pointer-events: none;
            }

            /* "TERMINAL 13.7" title text */
            .enter-terminal-title {
                font-size: 36px;
                margin-bottom: 40px;
                letter-spacing: 4px;
            }

            /* The main "ENTER TERMINAL" button */
            #enter-terminal-btn {
                background: transparent;
                border: 2px solid #00ff41;
                color: #00ff41;
                padding: 20px 60px;
                font-family: "Share Tech Mono", monospace;
                font-size: 18px;
                cursor: pointer;
                letter-spacing: 2px;
                transition: all 0.3s;
                margin-bottom: 30px;
            }

            /* Button hover effect */
            #enter-terminal-btn:hover {
                background: rgba(0, 255, 65, 0.1);
                box-shadow: 0 0 20px rgba(0, 255, 65, 0.5);
            }

            /* "Return to index" link below button */
            .escape-link {
                font-size: 12px;
                color: #666;
                text-decoration: none;
                transition: color 0.3s;
            }

            .escape-link:hover {
                color: #888;
            }

            /* =================================================================
           MAIN TERMINAL INTERFACE
           This is where all the story content lives
           ================================================================= */
            #main-terminal {
                display: none; /* Hidden until user enters */
                min-height: 100vh;
                padding: 60px;
                max-width: 1400px;
                margin: 0 auto;
            }

            /* Show main terminal when .active is added */
            #main-terminal.active {
                display: block;
            }

            /* =================================================================
           TERMINAL HEADER
           Top section with title, status, and controls
           ================================================================= */
            .terminal-header {
                border: 1px solid #00ff41;
                padding: 15px 20px;
                margin-bottom: 30px;
                background: rgba(0, 255, 65, 0.05);
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
            }

            /* Left side of header - title and status */
            .header-left {
                flex: 1;
            }

            /* "H2E Framework - Terminal 13.7" title */
            .terminal-title {
                font-size: 24px;
                margin-bottom: 5px;
                text-transform: uppercase;
                letter-spacing: 2px;
            }

            /* "STATUS: COMPROMISED" text */
            .terminal-status {
                font-size: 16px;
                color: #ff4444; /* Red for warning */
            }

            /* Right side of header - sound and exit buttons */
            .header-right {
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                gap: 10px;
            }

            /* =================================================================
           SOUND CONTROLS (in header)
           ================================================================= */
            .sound-control {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            /* Sound on/off toggle button */
            .sound-toggle {
                display: flex;
                align-items: center;
                gap: 8px;
                cursor: pointer;
                padding: 8px 12px;
                border: 1px solid #00ff41;
                background: rgba(0, 255, 65, 0.1);
                transition: all 0.3s;
                font-size: 14px;
            }

            .sound-toggle:hover {
                background: rgba(0, 255, 65, 0.2);
                box-shadow: 0 0 10px rgba(0, 255, 65, 0.3);
            }

            /* Volume slider container - hidden until sound is on */
            .volume-control {
                display: none;
                align-items: center;
                gap: 8px;
            }

            /* Show volume control when sound is enabled */
            .volume-control.visible {
                display: flex;
            }

            /* Volume slider styling */
            .volume-slider {
                width: 100px;
                height: 4px;
                -webkit-appearance: none;
                appearance: none;
                background: #333;
                outline: none;
                border-radius: 2px;
            }

            /* Volume slider thumb (the draggable circle) - Chrome/Safari */
            .volume-slider::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 12px;
                height: 12px;
                background: #00ff41;
                cursor: pointer;
                border-radius: 50%;
            }

            /* Volume slider thumb - Firefox */
            .volume-slider::-moz-range-thumb {
                width: 12px;
                height: 12px;
                background: #00ff41;
                cursor: pointer;
                border-radius: 50%;
                border: none;
            }

            /* Volume percentage label */
            .volume-label {
                font-size: 14px;
                color: #888;
                min-width: 35px;
            }

            /* =================================================================
           EXIT SYSTEM BUTTON (in header)
           ================================================================= */
            .exit-system-btn {
                background: transparent;
                border: 1px solid #ff4444; /* Red border */
                color: #ff4444;
                padding: 8px 16px;
                font-family: "Share Tech Mono", monospace;
                font-size: 14px;
                cursor: pointer;
                letter-spacing: 2px;
                text-transform: uppercase;
                transition: all 0.3s;
            }

            .exit-system-btn:hover {
                background: rgba(255, 68, 68, 0.1);
                box-shadow: 0 0 15px rgba(255, 68, 68, 0.3);
            }

            /* =================================================================
           EXIT CONFIRMATION MODAL
           Appears when user clicks EXIT SYSTEM
           ================================================================= */
            .exit-confirmation {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.95);
                z-index: 10002; /* Above everything except unload screen */
                align-items: center;
                justify-content: center;
            }

            /* Show confirmation when .active is added */
            .exit-confirmation.active {
                display: flex;
            }

            /* The modal box content */
            .exit-modal-content {
                border: 1px solid #ff4444;
                padding: 40px;
                background: #0a0a0a;
                max-width: 500px;
                text-align: center;
            }

            /* "CONFIRM SYSTEM EXIT" title */
            .exit-modal-title {
                font-size: 24px;
                color: #ff4444;
                margin-bottom: 20px;
                letter-spacing: 2px;
            }

            /* Warning message text */
            .exit-modal-message {
                font-size: 16px;
                color: #888;
                margin-bottom: 30px;
                line-height: 1.6;
            }

            /* Container for CANCEL and EXIT buttons */
            .exit-modal-buttons {
                display: flex;
                gap: 20px;
                justify-content: center;
            }

            /* Both CANCEL and EXIT buttons */
            .exit-modal-btn {
                padding: 12px 30px;
                border: 1px solid #00ff41;
                background: transparent;
                color: #00ff41;
                font-family: "Share Tech Mono", monospace;
                font-size: 16px;
                cursor: pointer;
                letter-spacing: 2px;
                transition: all 0.3s;
            }

            /* EXIT button (red) */
            .exit-modal-btn.danger {
                border-color: #ff4444;
                color: #ff4444;
            }

            .exit-modal-btn:hover {
                background: rgba(0, 255, 65, 0.1);
                box-shadow: 0 0 15px rgba(0, 255, 65, 0.3);
            }

            .exit-modal-btn.danger:hover {
                background: rgba(255, 68, 68, 0.1);
                box-shadow: 0 0 15px rgba(255, 68, 68, 0.3);
            }

            /* =================================================================
           UNLOAD PROGRESS SCREEN
           Shows when exiting - "UNLOADING TERMINAL 13.7..."
           ================================================================= */
            .unload-screen {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100vh;
                background: #000;
                z-index: 10003; /* Above everything */
                align-items: center;
                justify-content: center;
                flex-direction: column;
            }

            .unload-screen.active {
                display: flex;
            }

            /* "UNLOADING TERMINAL 13.7..." text */
            .unload-text {
                font-size: 18px;
                margin-bottom: 20px;
                color: #ff4444;
            }

            /* Progress bar during unload */
            .unload-bar {
                width: 300px;
                height: 20px;
                border: 1px solid #ff4444;
            }

            /* Red fill for unload progress bar */
            .unload-fill {
                height: 100%;
                background: #ff4444;
                width: 0%;
                animation: unloadProgress 2s forwards;
            }

            @keyframes unloadProgress {
                to {
                    width: 100%;
                }
            }

            /* =================================================================
           PRIORITY ALERT BOX
           "ACTIVE THREAD" warning about the three PreBorn
           ================================================================= */
            .priority-alert {
                margin-bottom: 40px;
                padding: 20px;
                border-left: 3px solid #ff4444;
                background: rgba(255, 68, 68, 0.05);
            }

            /* "ACTIVE THREAD" title */
            .alert-title {
                font-size: 16px;
                color: #ff4444;
                margin-bottom: 15px;
                letter-spacing: 1px;
            }

            /* Alert message text */
            .alert-text {
                font-size: 16px;
                color: #ddd;
                line-height: 1.8;
            }

            /* The PreBorn names in green */
            .thread-names {
                color: #00ff41;
            }

            /* =================================================================
           SECTION DIVIDERS
           Thin horizontal lines separating content sections
           ================================================================= */
            .section-divider {
                height: 1px;
                background: #333;
                margin: 40px 0;
            }

            /* =================================================================
           SECTION HEADERS
           Like "Begin Reading" and "Reference Materials"
           ================================================================= */
            .section-header {
                font-size: 14px;
                color: #00ff41;
                margin-bottom: 20px;
                letter-spacing: 2px;
                text-transform: uppercase;
            }

            /* =================================================================
           STORY LIST
           List of all story chapters (Prologue, Chaplet 1, etc.)
           ================================================================= */
            .story-list {
                list-style: none;
                margin-bottom: 40px;
            }

            /* Each story chapter row */
            .story-item {
                padding: 12px 0;
                border-bottom: 1px solid #222;
                display: flex;
                justify-content: space-between;
                align-items: center;
                transition: all 0.3s;
            }

            /* Hover effect - indent and add left border */
            .story-item:hover {
                padding-left: 10px;
                border-left: 2px solid #00ff41;
            }

            /* Progress status indicator */
            .story-status {
                display: inline-block;
                width: 22px;
                font-size: 18px;
                margin-right: 10px;
                text-align: center;
            }

            .story-status.not-started {
                color: #888;
            }

            .story-status.in-progress {
                color: #ffaa00;
            }

            .story-status.completed {
                color: #00ff41;
            }

            /* Story chapter title text */
            .story-title {
                color: #ddd;
                font-size: 16px;
                display: flex;
                align-items: center;
            }

            /* Available chapters (green) */
            .story-title.available {
                color: #00ff41;
            }

            /* In progress chapters (amber) */
            .story-title.in-progress {
                color: #ffaa00;
            }

            /* Completed chapters (green) */
            .story-title.completed {
                color: #00ff41;
            }

            /* Corrupted/unavailable chapters (red strikethrough) */
            .story-title.corrupted {
                color: #ff4444;
                text-decoration: line-through;
            }

            /* Container for AUDIO and READ buttons */
            .story-actions {
                display: flex;
                gap: 15px;
            }

            /* AUDIO and READ buttons */
            .story-btn {
                background: transparent;
                border: 1px solid #00ff41;
                color: #00ff41;
                padding: 5px 12px;
                font-family: "Share Tech Mono", monospace;
                font-size: 14px;
                cursor: pointer;
                transition: all 0.3s;
            }

            .story-btn:hover {
                background: rgba(0, 255, 65, 0.1);
                box-shadow: 0 0 8px rgba(0, 255, 65, 0.3);
            }

            /* Disabled buttons (grayed out) */
            .story-btn:disabled {
                opacity: 0.3;
                cursor: not-allowed;
            }

            /* =================================================================
           REFERENCE MATERIALS LINKS
           Object Registry, Glossary, System Logs
           ================================================================= */
            .reference-links {
                display: flex;
                gap: 20px;
                margin-bottom: 40px;
            }

            .reference-link {
                color: #00ff41;
                text-decoration: none;
                font-size: 14px;
                padding: 8px 15px;
                border: 1px solid #00ff41;
                transition: all 0.3s;
            }

            .reference-link:hover {
                background: rgba(0, 255, 65, 0.1);
                box-shadow: 0 0 10px rgba(0, 255, 65, 0.3);
            }

   


            /* =================================================================
           TERMINAL HINT
           "Press ` to access terminal" at bottom of page
           ================================================================= */
            .terminal-hint {
                text-align: center;
                padding: 30px;
                color: #666;
                font-size: 14px;
                border-top: 1px solid #222;
            }

            /* =================================================================
           HIDDEN TERMINAL (BACKTICK KEY)
           Command line interface that appears when pressing `
           ================================================================= */
            #hidden-terminal {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                background: rgba(0, 0, 0, 0.95);
                border-top: 2px solid #00ff41;
                padding: 20px;
                display: none;
                z-index: 10000;
            }

            /* Show terminal when .active is added */
            #hidden-terminal.active {
                display: block;
            }

            /* Command output area */
            .terminal-output {
                max-height: 200px;
                overflow-y: auto;
                margin-bottom: 10px;
                font-size: 12px;
                color: #ddd;
            }

            /* Input line with $ prompt */
            .terminal-input-line {
                display: flex;
                gap: 10px;
                align-items: center;
            }

            /* The $ prompt symbol */
            .terminal-prompt {
                color: #00ff41;
            }

            /* Command input field */
            #terminal-input {
                flex: 1;
                background: transparent;
                border: none;
                color: #00ff41;
                font-family: "Share Tech Mono", monospace;
                font-size: 12px;
                outline: none;
            }

            /* =================================================================
           MODAL SYSTEM
           Generic modal for displaying content (story, audio, ghost feed)
           ================================================================= */
            .modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.95);
                z-index: 10001;
                overflow-y: auto;
                padding: 0;
            }

            /* Show modal when .active is added */
            .modal.active {
                display: block;
            }

            /* Modal content box */
            .modal-content {
                max-width: 900px;
                margin: 0 auto;
                border: 1px solid #00ff41;
                padding: 30px;
                background: #0a0a0a; /* Dark background */
                position: relative;
            }

            /* Special case: terminal reader has no border/padding */
            .modal-content:has(.terminal-reader-wrapper) {
                border: none;
                padding: 0;
                background: transparent;
            }

            /* Close button in top right of modal */
            .modal-close {
                position: absolute;
                top: 10px;
                right: 10px;
                background: none;
                border: 1px solid #00ff41;
                color: #00ff41;
                padding: 5px 15px;
                cursor: pointer;
                font-family: inherit;
                font-size: 14px;
                transition: all 0.3s;
            }

            .modal-close:hover {
                background: rgba(0, 255, 65, 0.2);
            }

            /* Hide close button for terminal reader */
            .modal-content:has(.terminal-reader-wrapper) .modal-close {
                display: none;
            }

            .modal-content:has(.chaplet-reader) {
                border: none;
                padding: 0;
                background: transparent;
                max-width: 100%;
                width: 100%;
                height: 100vh;
            }

            .modal-content:has(.chaplet-reader) .modal-close {
                display: none;
            }

            /* Modal content with audio center */

            /* =================================================================
           GHOST FEED MODAL
           Observation relay system for viewing different realms
           ================================================================= */
            .ghost-feed-container {
                padding: 20px;
            }

            /* Header with warning symbol and title */
            .ghost-feed-header {
                border-left: 3px solid #ffaa00; /* Orange accent */
                padding-left: 15px;
                margin-bottom: 30px;
            }

            .ghost-feed-title {
                font-size: 18px;
                color: #ffaa00;
                margin-bottom: 8px;
                letter-spacing: 1px;
            }

            .ghost-feed-subtitle {
                font-size: 12px;
                color: #888;
            }

            /* Warning message box */
            .ghost-feed-warning {
                background: rgba(255, 170, 0, 0.1);
                border: 1px solid #ffaa00;
                padding: 12px 15px;
                margin-bottom: 30px;
                font-size: 11px;
                color: #ffaa00;
                line-height: 1.6;
            }

            /* Realm navigation section */
            .realm-navigation {
                margin-bottom: 30px;
                border: 1px solid #333;
                padding: 20px;
                background: rgba(0, 255, 65, 0.02);
            }

            /* "Use ↑↓ arrow keys" instruction */
            .nav-instruction {
                font-size: 11px;
                color: #888;
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 15px;
                text-align: center;
                padding: 8px;
                border: 1px solid #333;
                background: rgba(0, 0, 0, 0.5);
            }

            /* "Currently observing: X" display */
            .current-realm-display {
                margin-bottom: 15px;
                padding: 12px 15px;
                background: #000;
                border: 1px solid #00ff41;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .realm-label {
                font-size: 11px;
                color: #666;
                text-transform: uppercase;
            }

            .realm-name {
                font-size: 14px;
                color: #00ff41;
                font-weight: bold;
            }

            /* List of all realms */
            .realm-list {
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

            /* Individual realm item in list */
            .realm-list .dropdown-item {
                padding: 10px 15px;
                font-family: "Share Tech Mono", monospace;
                font-size: 12px;
                color: #666;
                border: 1px solid #222;
                background: #000;
                transition: all 0.2s;
            }

            /* Realm number (1., 2., etc.) */
            .realm-number {
                display: inline-block;
                width: 25px;
                color: #444;
            }

            /* Video/image viewing window */
            .feed-window {
                border: 1px solid #333;
                background: #000;
                min-height: 400px;
                margin-bottom: 20px;
                position: relative;
                overflow: hidden;
            }

            /* Scanline effect moving down the screen */
            .feed-window::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 2px;
                background: rgba(0, 255, 65, 0.3);
                animation: scanline 3s linear infinite;
                pointer-events: none;
            }

            /* Content inside feed window */
            .feed-content {
                padding: 40px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 400px;
            }

            /* Placeholder shown before selecting a realm */
            .feed-placeholder {
                width: 100%;
                max-width: 500px;
                aspect-ratio: 16/9;
                background: rgba(0, 255, 65, 0.05);
                border: 1px dashed #333;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                gap: 15px;
                margin-bottom: 20px;
            }

            /* Antenna icon in placeholder */
            .feed-placeholder-icon {
                font-size: 48px;
                opacity: 0.3;
            }

            .feed-placeholder-text {
                font-size: 12px;
                color: #666;
                text-align: center;
