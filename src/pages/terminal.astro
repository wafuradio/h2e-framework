                    statusClass: "",
                    imagePath: "/images/ghost-feed/io.mp4",
                    mediaType: "video",
                },
                5: {
                    key: "realm-beyond",
                    name: "Realm Beyond",
                    description:
                        "Unstable instability zone. Deprecated logic fragments. Glitch terrain. Unauthorized PreBorn traversal detected.",
                    signalStrength: 31,
                    status: "DEGRADED - PARTIAL RECOVERY",
                    statusClass: "degraded",
                    imagePath: "/images/ghost-feed/realm-beyond.png",
                },
                6: {
                    key: "edge-of-system",
                    name: "Edge of the System",
                    description:
                        "foedus sanctuary. Exclusion zone. Deprecated code accumulation. Signal barely readable. Extreme corruption.",
                    signalStrength: 12,
                    status: "CRITICAL - MINIMAL RECOVERY",
                    statusClass: "critical",
                    imagePath: "/images/ghost-feed/edge-of-system.png",
                },
            };

            // Create lookup object by realm key (e.g., "io", "grove-of-accord")
            const realmByKey = {};
            Object.values(realmData).forEach((realm) => {
                realmByKey[realm.key] = realm;
            });

            // =================================================================
            // GHOST FEED MODAL FUNCTIONS
            // Handles the observation relay interface
            // =================================================================

            let currentSelectedRealm = null; // Currently selected realm number
            let highlightedRealmIndex = 0; // For keyboard navigation (0-indexed)

            /**
             * Opens the Ghost Feed modal
             * @param {number} realmNumber - Optional realm to select immediately (1-6)
             */
            window.showGhostFeed = function (realmNumber) {
                console.log(
                    "🌐 showGhostFeed called with realmNumber:",
                    realmNumber,
                );
                console.log("realmData:", realmData);

                // Generate HTML for all realm options in dropdown
                const dropdownItems = Object.keys(realmData)
                    .map((num) => {
                        const realm = realmData[num];
                        return `
                    <div class="dropdown-item" data-realm="${num}">
                        <span class="realm-number">${num}.</span> ${realm.name}
                    </div>
                `;
                    })
                    .join("");

                // Build the entire Ghost Feed interface
                document.getElementById("modal-body").innerHTML = `
                <div class="ghost-feed-container">
                    <!-- Header with warning -->
                    <div class="ghost-feed-header">
                        <div class="ghost-feed-title">⚠️ UNAUTHORIZED OBSERVATION RELAY</div>
                        <div class="ghost-feed-subtitle">Ghost Feed Access - Deprecated Channels</div>
                    </div>
                    
                    <!-- Warning message -->
                    <div class="ghost-feed-warning">
                        WARNING: These observation relays were never decommissioned. Access constitutes protocol violation. 
                        Praetores monitoring systems may flag unauthorized usage. Proceed with discretion.
                    </div>
                    
                    <!-- Realm navigation -->
                    <div class="realm-navigation">
                        <div class="nav-instruction">NAVIGATION: Use ↑↓ arrow keys to switch realms</div>
                        <div class="current-realm-display" id="current-realm-display">
                            <span class="realm-label">Currently observing:</span>
                            <span class="realm-name" id="current-realm-name">Awaiting selection...</span>
                        </div>
                        <div class="realm-list" id="realm-list">
                            ${dropdownItems}
                        </div>
                    </div>
                    
                    <!-- Video/image viewing window -->
                    <div class="feed-window">
                        <div class="feed-content" id="feed-content">
                            <div class="feed-placeholder">
                                <div class="feed-placeholder-icon">📡</div>
                                <div class="feed-placeholder-text">
                                    Press → or ↓ to begin observation
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Signal quality indicator -->
                    <div class="signal-quality" id="signal-quality" style="display: none;">
                        <div class="signal-quality-label">Signal Quality</div>
                        <div class="signal-bars" id="signal-bars">
                            <div class="signal-bar"></div>
                            <div class="signal-bar"></div>
                            <div class="signal-bar"></div>
                            <div class="signal-bar"></div>
                            <div class="signal-bar"></div>
                        </div>
                        <div class="signal-status" id="signal-status">
                            <strong>--</strong> | STATUS: AWAITING CONNECTION
                        </div>
                    </div>
                </div>
            `;

                // Show the modal
                document
                    .getElementById("content-modal")
                    .classList.add("active");

                // Initialize keyboard navigation after DOM is ready
                setTimeout(() => {
                    if (realmNumber && realmData[realmNumber]) {
                        highlightedRealmIndex = realmNumber - 1; // Convert to 0-indexed
                        selectRealm(realmNumber);
                    } else {
                        highlightedRealmIndex = 0; // Start at first item
                        console.log(
                            "No realm number provided, highlighting first item (index 0)",
                        );
                        updateHighlight(); // Highlight first item
                    }

                    // Set up keyboard event listener
                    setupDropdownKeyboardNav();
                }, 50); // Small delay to ensure DOM is rendered
            };

            /**
             * Selects a specific realm and displays its content
             * @param {number} realmNumber - Realm to select (1-6)
             */
            window.selectRealm = function (realmNumber) {
                currentSelectedRealm = realmNumber;
                const realm = realmData[realmNumber];

                // Update "Currently observing" display
                const realmNameDisplay =
                    document.getElementById("current-realm-name");
                if (realmNameDisplay) {
                    realmNameDisplay.textContent = `→ ${realm.name} [${realm.signalStrength}% ${realm.status}]`;
                }

                // Update the video/image feed
                updateGhostFeed(realm);
            };

            /**
             * Updates visual highlight in dropdown list
             */
            function updateHighlight() {
                const items = document.querySelectorAll(
                    ".realm-list .dropdown-item",
                );
                console.log(
                    "updateHighlight called - highlightedRealmIndex:",
                    highlightedRealmIndex,
                );
                console.log("Found realm items:", items.length);

                items.forEach((item, index) => {
                    if (index === highlightedRealmIndex) {
                        // Highlight this item
                        item.style.backgroundColor = "#00ff41";
                        item.style.color = "#000";
                        item.style.borderColor = "#00ff41";
                        console.log(
                            "Highlighted item",
                            index,
                            ":",
                            item.textContent.trim(),
                        );
                    } else {
                        // Clear highlight
                        item.style.backgroundColor = "";
                        item.style.color = "";
                        item.style.borderColor = "";
                    }
                });

                // Auto-select the highlighted realm
                const realmNumber = highlightedRealmIndex + 1; // Convert to 1-indexed
                console.log("Auto-selecting realm:", realmNumber);
                selectRealm(realmNumber);
            }

            /**
             * Sets up keyboard navigation (arrow keys)
             */
            function setupDropdownKeyboardNav() {
                // Remove old listener if exists
                document.removeEventListener("keydown", handleDropdownKeydown);
                document.addEventListener("keydown", handleDropdownKeydown);
            }

            /**
             * Handles keyboard input for dropdown navigation
             * @param {KeyboardEvent} e - The keyboard event
             */
            function handleDropdownKeydown(e) {
                // Only handle keys when modal is open
                if (
                    !document
                        .getElementById("content-modal")
                        .classList.contains("active")
                ) {
                    return;
                }

                console.log("handleDropdownKeydown - key pressed:", e.key);

                const items = document.querySelectorAll(
                    ".realm-list .dropdown-item",
                );
                const maxIndex = items.length - 1;

                if (e.key === "ArrowDown") {
                    e.preventDefault();
                    console.log("ArrowDown: before:", highlightedRealmIndex);
                    highlightedRealmIndex = Math.min(
                        highlightedRealmIndex + 1,
                        maxIndex,
                    );
                    console.log("ArrowDown: after:", highlightedRealmIndex);
                    updateHighlight();
                } else if (e.key === "ArrowUp") {
                    e.preventDefault();
                    console.log("ArrowUp: before:", highlightedRealmIndex);
                    highlightedRealmIndex = Math.max(
                        highlightedRealmIndex - 1,
                        0,
                    );
                    console.log("ArrowUp: after:", highlightedRealmIndex);
                    updateHighlight();
                } else if (e.key === "Escape") {
                    e.preventDefault();
                    // Close the entire modal
                    closeModal();
                }
            }

            /**
             * Updates the Ghost Feed display with realm content
             * @param {object} realm - Realm data object
             */
            window.updateGhostFeed = function (realm) {
                // Build media content based on type
                let mediaHTML = "";

                if (realm.mediaType === "video") {
                    // Video element for .mp4 files
                    mediaHTML = `
                    <video 
                        class="feed-video" 
                        autoplay 
                        loop 
                        muted 
                        playsinline
                        style="width: 100%; max-width: 600px; height: auto; display: block; border: 1px solid #333;"
                    >
                        <source src="${realm.imagePath}" type="video/mp4">
                        Your browser does not support video playback.
                    </video>
                `;
                } else {
                    // Placeholder for images (real images would go here)
                    mediaHTML = `
                    <div class="feed-placeholder">
                        <div class="feed-placeholder-icon">📡</div>
                        <div class="feed-placeholder-text">
                            [Placeholder for animated loop]<br>
                            ${realm.name}
                        </div>
                    </div>
                `;
                }

                // Update feed content
                document.getElementById("feed-content").innerHTML = `
                ${mediaHTML}
                <div class="realm-description">${realm.description}</div>
            `;

                // Show and update signal quality section
                document.getElementById("signal-quality").style.display =
                    "block";

                // Update signal bars (light up based on signal strength)
                const bars = document.querySelectorAll(".signal-bar");
                const activeBars = Math.ceil((realm.signalStrength / 100) * 5);
                bars.forEach((bar, index) => {
                    if (index < activeBars) {
                        bar.classList.add("active");
                    } else {
                        bar.classList.remove("active");
                    }
                });

                // Update signal status text
                const statusElement = document.getElementById("signal-status");
                statusElement.className = `signal-status ${realm.statusClass}`;
                statusElement.innerHTML = `<strong>${realm.signalStrength}%</strong> | STATUS: ${realm.status}`;
            };

            // =================================================================
            // SOUND MANAGEMENT WITH LOCALSTORAGE
            // Saves user preferences between sessions
            // =================================================================

            let ambientSound = null; // Background server room sound
            let soundEnabled = false; // Is sound currently on?
            let volumeLevel = 40; // Volume percentage (0-100)

            /**
             * Loads sound preferences from localStorage
             */
            function loadSoundPreferences() {
                const savedSound = localStorage.getItem("h2e_sound_enabled");
                const savedVolume = localStorage.getItem("h2e_volume_level");

                if (savedSound !== null) {
                    soundEnabled = savedSound === "true";
                }

                if (savedVolume !== null) {
                    volumeLevel = parseInt(savedVolume);
                }

                updateSoundUI();
            }

            /**
             * Saves sound preferences to localStorage
             */
            function saveSoundPreferences() {
                localStorage.setItem(
                    "h2e_sound_enabled",
                    soundEnabled.toString(),
                );
                localStorage.setItem(
                    "h2e_volume_level",
                    volumeLevel.toString(),
                );
            }

            /**
             * Creates audio objects for ambient sound
             */
            function initializeSounds() {
                ambientSound = new Audio("/sounds/ambient-server-room.mp3");
                ambientSound.loop = true;
                ambientSound.volume = volumeLevel / 100;
            }

            /**
             * Updates sound UI elements to reflect current state
             */
            function updateSoundUI() {
                const icon = document.getElementById("sound-icon");
                const label = document.getElementById("sound-label");
                const volumeControl = document.getElementById("volume-control");
                const volumeSlider = document.getElementById("volume-slider");
                const volumeLabel = document.getElementById("volume-label");

                if (soundEnabled) {
                    icon.textContent = "🔊";
                    label.textContent = "SOUND: ON";
                    volumeControl.classList.add("visible");
                } else {
                    icon.textContent = "🔇";
                    label.textContent = "SOUND: OFF";
                    volumeControl.classList.remove("visible");
                }

                volumeSlider.value = volumeLevel;
                volumeLabel.textContent = volumeLevel + "%";
            }

            /**
             * Toggles sound on/off when user clicks sound button
             */
            window.toggleSound = function () {
                soundEnabled = !soundEnabled;

                if (soundEnabled) {
                    if (ambientSound) {
                        ambientSound
                            .play()
                            .catch((e) => console.log("Audio play failed:", e));
                    }
                } else {
                    if (ambientSound) {
                        ambientSound.pause();
                    }
                }

                updateSoundUI();
                saveSoundPreferences();
            };

            // Set up volume slider event listener when page loads
            document.addEventListener("DOMContentLoaded", () => {
                const volumeSlider = document.getElementById("volume-slider");
                const volumeLabel = document.getElementById("volume-label");

                volumeSlider.addEventListener("input", (e) => {
                    volumeLevel = parseInt(e.target.value);
                    volumeLabel.textContent = volumeLevel + "%";

                    if (ambientSound) {
                        ambientSound.volume = volumeLevel / 100;
                    }

                    saveSoundPreferences();
                });
            });

            // =================================================================
            // BOOT SEQUENCE WITH SESSION CHECK
            // Skips boot animation if user already visited this session
            // =================================================================

            /**
             * Checks if user has already seen boot sequence this session
             * If yes, skips directly to terminal
             * If no, shows boot sequence
             */
            function checkBootStatus() {
                const hasBooted = sessionStorage.getItem("h2e_terminal_booted");

                if (hasBooted === "true") {
                    console.log("🔄 Returning user - skipping boot sequence");
                    // Skip boot and audio gate, go directly to terminal
                    document.getElementById("boot-sequence").style.display =
                        "none";
                    document.getElementById(
                        "enter-terminal-screen",
                    ).style.display = "none";
                    document
                        .getElementById("main-terminal")
                        .classList.add("active");

                    // Initialize sounds with saved preferences
                    initializeSounds();
                    loadSoundPreferences();

                    // Start ambient sound if enabled
                    if (soundEnabled && ambientSound) {
                        ambientSound
                            .play()
                            .catch((e) => console.log("Audio play failed:", e));
                    }
                } else {
                    console.log("👋 First visit - showing boot sequence");
                    // Show normal boot sequence
                    setTimeout(() => {
                        document
                            .getElementById("boot-sequence")
                            .classList.add("hidden");
                        document
                            .getElementById("enter-terminal-screen")
                            .classList.add("active");
                    }, 6000); // 6 seconds for boot animation
                }
            }

            // Run boot check when page loads
            checkBootStatus();

            // =================================================================
            // ENTER TERMINAL HANDLER
            // Handles clicking the "ENTER TERMINAL" button
            // =================================================================
            document
                .getElementById("enter-terminal-btn")
                .addEventListener("click", () => {
                    // Mark that boot has completed this session
                    sessionStorage.setItem("h2e_terminal_booted", "true");
                    console.log("✅ Boot completed - session flag set");

                    // Fade out enter screen
                    document
                        .getElementById("enter-terminal-screen")
                        .classList.add("hidden");

                    setTimeout(() => {
                        document.getElementById(
                            "enter-terminal-screen",
                        ).style.display = "none";
                        document
                            .getElementById("main-terminal")
                            .classList.add("active");

                        // Initialize and start ambient sound
                        initializeSounds();
                        loadSoundPreferences();

                        if (soundEnabled && ambientSound) {
                            ambientSound
                                .play()
                                .catch((e) =>
                                    console.log("Audio play failed:", e),
                                );
                        }
                    }, 500);
                });

            // =================================================================
            // HIDDEN TERMINAL (BACKTICK KEY)
            // Command line interface activated by pressing `
            // =================================================================

            let terminalOpen = false; // Is terminal currently visible?
            let commandHistory = []; // Array of previous commands
            let historyIndex = -1; // Current position in history

            /**
             * Loads command history from localStorage
             */
            function loadCommandHistory() {
                const saved = localStorage.getItem("h2e_terminal_history");
                if (saved) {
                    try {
                        commandHistory = JSON.parse(saved);
                    } catch (e) {
                        commandHistory = [];
                    }
                }
            }

            /**
             * Saves command history to localStorage
             * Keeps only last 20 commands
             */
            function saveCommandHistory() {
                if (commandHistory.length > 20) {
                    commandHistory = commandHistory.slice(-20);
                }
                localStorage.setItem(
                    "h2e_terminal_history",
                    JSON.stringify(commandHistory),
                );
            }

            /**
             * Adds a command to history
             * @param {string} command - The command to add
             */
            function addToHistory(command) {
                if (command.trim() === "") return;

                // Don't add duplicate of last command
                if (
                    commandHistory.length > 0 &&
                    commandHistory[commandHistory.length - 1] === command
                ) {
                    return;
                }

                commandHistory.push(command);
                saveCommandHistory();
                historyIndex = commandHistory.length; // Reset to end
            }

            /**
             * Navigates command history with arrow keys
             * @param {string} direction - 'up' or 'down'
             * @returns {string} Command at current history position
             */
            function navigateHistory(direction) {
                if (commandHistory.length === 0) return "";

                if (direction === "up") {
                    if (historyIndex > 0) {
                        historyIndex--;
                    }
                } else if (direction === "down") {
                    if (historyIndex < commandHistory.length) {
                        historyIndex++;
                    }
                }

                // Return command at current index, or empty if at end
                if (historyIndex < commandHistory.length) {
                    return commandHistory[historyIndex];
                } else {
                    return "";
                }
            }

            // Load history on page load
            loadCommandHistory();

            // Listen for backtick key to toggle terminal
            document.addEventListener("keydown", (e) => {
                if (e.key === "`") {
                    e.preventDefault();
                    terminalOpen = !terminalOpen;
                    const terminal = document.getElementById("hidden-terminal");

                    if (terminalOpen) {
                        terminal.classList.add("active");
                        document.getElementById("terminal-input").focus();
                        historyIndex = commandHistory.length; // Reset to end when opening
                    } else {
                        terminal.classList.remove("active");
                    }
                }

                // Close terminal with Escape key
                if (e.key === "Escape" && terminalOpen) {
                    terminalOpen = false;
                    document
                        .getElementById("hidden-terminal")
                        .classList.remove("active");
                }
            });

            // Handle command input and execution
            document
                .getElementById("terminal-input")
                .addEventListener("keydown", (e) => {
                    // Handle up/down arrow for command history
                    if (e.key === "ArrowUp") {
                        e.preventDefault();
                        const command = navigateHistory("up");
                        e.target.value = command;
                        // Move cursor to end
                        setTimeout(() => {
                            e.target.selectionStart = e.target.selectionEnd =
                                e.target.value.length;
                        }, 0);
                        return;
                    }

                    if (e.key === "ArrowDown") {
                        e.preventDefault();
                        const command = navigateHistory("down");
                        e.target.value = command;
                        // Move cursor to end
                        setTimeout(() => {
                            e.target.selectionStart = e.target.selectionEnd =
                                e.target.value.length;
                        }, 0);
                        return;
                    }

                    // Execute command on Enter
                    if (e.key === "Enter") {
                        const input = e.target.value.trim();
                        const output =
                            document.getElementById("terminal-output");

                        // Add to history before processing
                        if (input !== "") {
                            addToHistory(input);
                        }

                        // Display the command in output
                        const commandLine = document.createElement("div");
                        commandLine.textContent = "$ " + input;
                        commandLine.style.color = "#00ff41";
                        output.appendChild(commandLine);

                        // Process the command
                        if (input === "help") {
                            // Show available commands
                            const helpText = document.createElement("div");
                            helpText.innerHTML = `
                                AVAILABLE COMMANDS:<br>
                                /ghost_feed [1-6]  - Access observation relays<br>
                                /logs              - System telemetry archive<br>
                                /echo foedus       - Search deprecated archives<br>
                                /mark_finished     - Mark chaplet as finished (requires ID)<br>
                                /reset_progress    - Reset reading progress<br>
                                help               - Display this message<br>
                                clear              - Clear terminal<br>
                                                    `;
                            output.appendChild(helpText);
                        } else if (input === "clear") {
                            // Clear terminal output
                            output.innerHTML = "";
                        } else if (input.startsWith("/ghost_feed")) {
                            // Ghost feed command
                            console.log("📡 /ghost_feed command detected");
                            const parts = input.split(" ");
                            const realmNumber = parts[1]
                                ? parseInt(parts[1])
                                : null;
                            console.log("Parsed realm number:", realmNumber);

                            if (
                                realmNumber &&
                                (realmNumber < 1 || realmNumber > 6)
                            ) {
                                // Invalid realm number
                                const errorText = document.createElement("div");
                                errorText.textContent = `Invalid realm number: ${realmNumber}. Valid range: 1-6`;
                                errorText.style.color = "#ff4444";
                                output.appendChild(errorText);
                            } else {
                                // Valid command - show loading message
                                const response = document.createElement("div");
                                if (realmNumber) {
                                    response.textContent = `Initializing Ghost Feed relay system... Direct access to realm ${realmNumber}`;
                                } else {
                                    response.textContent =
                                        "Initializing Ghost Feed relay system...";
                                }
                                response.style.color = "#00ff41";
                                output.appendChild(response);

                                // Close terminal and open ghost feed
                                setTimeout(() => {
                                    terminalOpen = false;
                                    document
                                        .getElementById("hidden-terminal")
                                        .classList.remove("active");
                                    showGhostFeed(realmNumber);
                                }, 500);
                            }
                        } else if (input === "/echo foedus") {
                            // Coming soon command
                            const response = document.createElement("div");
                            response.textContent =
                                "[COMING SOON] Searching deprecated archives...";
                            response.style.color = "#ffaa00";
                            output.appendChild(response);
                        } else if (input.startsWith("/mark_finished")) {
                            // Mark chaplet as finished command
                            const parts = input.split(" ");
                            const chapletId = parts[1];
                            
                            if (!chapletId) {
                                const errorText = document.createElement("div");
                                errorText.textContent = "Error: Chaplet ID required. Usage: /mark_finished chaplet1";
                                errorText.style.color = "#ff4444";
                                output.appendChild(errorText);
                            } else {
                                markAsFinished(chapletId);
                                const response = document.createElement("div");
                                response.textContent = `✓ ${chapletId} marked as finished.`;
                                response.style.color = "#00ff41";
                                output.appendChild(response);
                            }
                        } else if (input === "/reset_progress") {
                            // Reset progress command
                            resetProgress();
                            const response = document.createElement("div");
                            response.textContent =
                                "✓ Reading progress reset. All chaplets marked as unread.";
                            response.style.color = "#00ff41";
                            output.appendChild(response);
                        
                         } else if (input === "/logs") {
                            // System logs command
                            const response = document.createElement("div");
                            response.textContent = "Accessing system telemetry...";
                            response.style.color = "#00ff41";
                            output.appendChild(response);

                            // Close terminal and navigate to logs
                            setTimeout(() => {
                                terminalOpen = false;
                                document
                                    .getElementById("hidden-terminal")
                                    .classList.remove("active");
                                window.location.href = '/logs';
                            }, 500);
                        } else if (input !== "") {
                            // Unknown command
                            const errorText = document.createElement("div");
                            errorText.textContent = `Command not found: ${input}`;
                            errorText.style.color = "#ff4444";
                            output.appendChild(errorText);
                        }

                        // Scroll to bottom and clear input
                        output.scrollTop = output.scrollHeight;
                        e.target.value = "";
                    }
                });

            // =================================================================
            // PROLOGUE CONTENT
            // The actual text of the prologue story
            // =================================================================
            const prologueText = `<p style="font-style: italic; font-size: 22px; ">“I gave you order. I did not stay to maintain it.”</p>
               
                I built the Framework.
                I did not build it well.

                I thought I could manage it.
                I thought order was enough.
                I thought logic would protect you.

                It never did.

                The flaw was in the root.
                A line written without care.
                A rule that never should have stayed.

