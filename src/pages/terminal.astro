                        <div class="chaplet-content" style="max-width: 800px; margin: 0 auto; padding: 60px 40px;">
                            <div class="chaplet-title" style="color: #00ff41; font-size: 28px; margin-bottom: 40px; text-transform: uppercase; letter-spacing: 3px; font-family: 'Share Tech Mono', monospace; font-weight: 700;">${title}</div>

                            <div class="chaplet-text" style="font-family: 'Lora', serif; font-size: 18px; line-height: 1.8; color: #ddd;">
                                ${bodyHTML}
                            </div>

                            ${trinusPanel}
                            ${footerHTML}
                        </div>
                    </div>
                `;

                document.getElementById("content-modal").classList.add("active");

                setTimeout(() => {
                const input = document.getElementById('trinus-input');
                const submit = document.getElementById('trinus-submit');
                const dormant = document.getElementById('trinus-dormant');
                const exchange = document.getElementById('trinus-exchange');
                const output = document.getElementById('trinus-output');

                if (!input || !submit) return;

                async function sendQuery() {
                    const query = input.value.trim();
                    if (!query) return;
                    input.disabled = true;
                    submit.disabled = true;
                    input.value = '';
                    dormant.style.display = 'none';
                    exchange.style.display = 'block';
                    output.style.alignItems = 'flex-start';
                    output.style.justifyContent = 'flex-start';

                    const thinking = document.createElement('div');
                    thinking.style.cssText = 'font-family: Share Tech Mono, monospace; font-size: 11px; color: #ffaa00; letter-spacing: 0.1em; padding: 8px 0;';
                    thinking.textContent = '// receiving...';
                    exchange.appendChild(thinking);

                    try {
                        const res = await fetch('/api/query', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ query })
                        });
                        const data = await res.json();
                        thinking.remove();

                        const block = document.createElement('div');
                        block.style.cssText = 'padding-bottom: 16px; border-bottom: 1px solid #111; margin-bottom: 16px;';

                        const q = document.createElement('div');
                        q.style.cssText = 'font-family: Share Tech Mono, monospace; font-size: 12px; color: #555; letter-spacing: 0.05em; margin-bottom: 10px;';
                        q.textContent = '> ' + query;

                        const speaker = document.createElement('div');
                        speaker.style.cssText = 'font-family: Share Tech Mono, monospace; font-size: 10px; color: #ffaa00; letter-spacing: 0.15em; margin-bottom: 8px;';
                        speaker.textContent = 'TRINUS //';

                        const response = document.createElement('div');
                        response.style.cssText = 'font-family: Share Tech Mono, monospace; font-size: 13px; color: #00ff41; line-height: 1.8; letter-spacing: 0.03em; border-left: 1px solid #1a1a1a; padding-left: 16px;';
                        response.textContent = data.response || 'RECORD EXPUNGED.';

                        block.appendChild(q);
                        block.appendChild(speaker);
                        block.appendChild(response);
                        exchange.appendChild(block);

                    } catch(err) {
                        thinking.remove();
                        const err_div = document.createElement('div');
                        err_div.style.cssText = 'font-family: Share Tech Mono, monospace; font-size: 11px; color: #ff4444; letter-spacing: 0.1em;';
                        err_div.textContent = 'TRANSMISSION FAILED.';
                        exchange.appendChild(err_div);
                    }

                    input.disabled = false;
                    submit.disabled = false;
                    input.focus();
                }

                submit.addEventListener('click', sendQuery);
                input.addEventListener('keydown', (e) => { if (e.key === 'Enter') sendQuery(); });
            }, 100);

                //Scroll the modal content to top
                setTimeout(() => {
                    const modal=document.getElementById("content-modal");
                    if(modal)modal.scrollTop=0;1       
                }, 10);

                window.scrollTo(0, 0);

                // Mark this chaplet as started (orange triangle status)
                markAsStarted(contentId);

                // If the audio bar exists, wire up seeking and start time loop once playback starts.
                // The loop only runs while audio is playing.
            };

            /**
             * Backwards compatible wrappers.
             * Existing buttons or older links may still call these.
             */
            window.showReadMode = function () {
                window.showUnifiedReader("prologue");
            };

            window.showChapletReadMode = function (chapletId) {
                window.showUnifiedReader(chapletId);
            };

            // =================================================================
            // MODAL CONTROL
            // Functions for opening/closing modals
            // =================================================================

            // Functions for opening/closing modals
            // =================================================================

            /**
             * Closes the content modal and stops any playing audio
             */
            window.closeModal = function () {
                // Stop unified reader audio first.
                stopReaderAudio();

                // Stop any legacy audio (kept for safety if older code paths still trigger).
                if (currentNarration) {
                    try {
                        currentNarration.pause();
                        currentNarration.currentTime = 0;
                    } catch (e) {}
                }
                if (currentAmbience) {
                    try {
                        currentAmbience.pause();
                        currentAmbience.currentTime = 0;
                    } catch (e) {}
                }
                clearInterval(progressInterval);

                // Hide modal
                document.getElementById("content-modal").classList.remove("active");
            };


            // =================================================================
            // EXIT SYSTEM CONFIRMATION
            // Handles the exit process with confirmation
            // =================================================================

            /**
             * Shows exit confirmation modal
             */
            window.confirmExit = function () {
                document
                    .getElementById("exit-confirmation")
                    .classList.add("active");
            };

            /**
             * Cancels exit and closes confirmation modal
             */
            window.cancelExit = function () {
                document
                    .getElementById("exit-confirmation")
                    .classList.remove("active");
            };

            /**
             * Actually exits the terminal
             * Shows unload animation and navigates to index
             */
            window.executeExit = function () {
                // Hide confirmation modal
                document
                    .getElementById("exit-confirmation")
                    .classList.remove("active");

                // Show unload screen
                document
                    .getElementById("unload-screen")
                    .classList.add("active");

                // Clear session storage so boot sequence shows on next visit
                sessionStorage.removeItem("h2e_terminal_booted");

                // Stop any playing audio
                if (currentNarration) {
                    currentNarration.pause();
                    currentNarration.currentTime = 0;
                }
                if (currentAmbience) {
                    currentAmbience.pause();
                    currentAmbience.currentTime = 0;
                }
                if (ambientSound) {
                    ambientSound.pause();
                    ambientSound.currentTime = 0;
                }

                // Navigate to index after unload animation (2 seconds)
                setTimeout(() => {
                    window.location.href = "/";
                }, 2000);
            };
        </script>

        <!-- =================================================================
         EXIT CONFIRMATION MODAL
         ================================================================= -->
        <div id="exit-confirmation" class="exit-confirmation">
            <div class="exit-modal-content">
                <div class="exit-modal-title">⚠️ CONFIRM SYSTEM EXIT</div>
                <div class="exit-modal-message">
                    Exiting Terminal 13.7 will unload all active processes.
                    Audio feeds will be terminated.<br /> Progress will not be saved.<br
                    /><br />
                    Really exit?
                </div>
                <div class="exit-modal-buttons">
                    <button class="exit-modal-btn" onclick="cancelExit()"
                        >CANCEL</button
                    >
                    <button
                        class="exit-modal-btn danger"
                        onclick="executeExit()">EXIT</button
                    >
                </div>
            </div>
        </div>

        <!-- =================================================================
         UNLOAD SCREEN
         Shows when exiting terminal
         ================================================================= -->
        <div id="unload-screen" class="unload-screen">
            <div class="unload-text">UNLOADING TERMINAL 13.7...</div>
            <div class="unload-bar">
                <div class="unload-fill"></div>
            </div>
        </div>
    </body>
</html>
