            // =================================================================
            // PROGRESS TRACKING SYSTEM
            // Tracks which chaplets user has started/completed
            // =================================================================
            
            /**
             * Updates all progress indicators on page load
             */
            function updateProgressIndicators() {
                const chaplets = ['prologue', 'chaplet1', 'chaplet2', 'chaplet3', 'chaplet35', 'chaplet4', 'chaplet45', 'chaplet5'];
                
                chaplets.forEach(id => {
                    const statusEl = document.getElementById(`status-${id}`);
                    const titleEl = document.querySelector(`[data-chaplet="${id}"] .story-title`);
                    
                    if (!statusEl || !titleEl) return;
                    
                    if (localStorage.getItem(`h2e_${id}_completed`)) {
                        // Completed
                        statusEl.textContent = '✓';
                        statusEl.className = 'story-status completed';
                        titleEl.classList.add('completed');
                        titleEl.classList.remove('in-progress', 'available');
                    } else if (localStorage.getItem(`h2e_${id}_started`)) {
                        // In Progress
                        statusEl.textContent = '▶';
                        statusEl.className = 'story-status in-progress';
                        titleEl.classList.add('in-progress');
                        titleEl.classList.remove('completed', 'available');
                    } else {
                        // Not Started
                        statusEl.textContent = '●';
                        statusEl.className = 'story-status not-started';
                        titleEl.classList.remove('completed', 'in-progress');
                    }
                });
            }
            
            /**
             * Marks a chaplet as started (when user opens it)
             */
            function markAsStarted(chapletId) {
                // Only mark as started if not already completed
                if (!localStorage.getItem(`h2e_${chapletId}_completed`)) {
                    localStorage.setItem(`h2e_${chapletId}_started`, 'true');
                    updateProgressIndicators();
                }
            }
            
            /**
             * Marks a chaplet as finished (user clicks button or reaches end)
             */
            window.markAsFinished = function(chapletId) {
                localStorage.setItem(`h2e_${chapletId}_completed`, 'true');
                localStorage.removeItem(`h2e_${chapletId}_started`); // Remove "in progress"
                updateProgressIndicators();
                
                // Show confirmation
                alert('✓ Chaplet marked as completed!');
