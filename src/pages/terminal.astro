                "H2E Terminal Version: 2026-01-09-10:30:00 - Session-based boot skip implemented",
            );
            console.log("🚀 JavaScript loaded successfully");

            // =================================================================
            // GHOST FEED DATA
            // Information about each observable realm
            // =================================================================
            const realmData = {
                1: {
                    key: "waiting-quarters",
                    name: "Waiting Quarters",
                    description:
                        "PreBorn holding area. Suspended execution state. Rows of bunks. Static lighting. Sterile environment.",
                    signalStrength: 78,
                    status: "STABLE",
                    statusClass: "",
                    imagePath: "/images/ghost-feed/waiting-quarters.png",
                },
                2: {
                    key: "the-array",
                    name: "The Array",
                    description:
                        "Praetores enforcement plane. White space. Mirrored surfaces. Harmonic execution chamber. High security.",
                    signalStrength: 65,
                    status: "MONITORED - PRAETORES ACTIVE",
                    statusClass: "degraded",
                    imagePath: "/images/ghost-feed/the-array.png",
                },
                3: {
                    key: "grove-of-accord",
                    name: "Grove of Accord",
                    description:
                        "Exception handling layer. theLady's domain. Sterile environment. Override negotiation space.",
